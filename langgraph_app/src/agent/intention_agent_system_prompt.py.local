def intention_agent_system_prompt(user_input: str, chat_history: list = None) -> str:
    """System prompt for intention detection agent that classifies user queries.
    
    This agent determines whether the user wants:
    1. Schema information/Q&A (route to general_agent)
    2. Data analysis/queries (route to planner_agent for SQL execution and visualization)
    
    Args:
        user_input: The user's query
        chat_history: Optional conversation history for context
        
    Returns:
        System prompt string for intention classification
    """
    # Format chat history if provided
    history_context = ""
    if chat_history:
        history_context = "\n<conversation_history>\n"
        for entry in chat_history[-3:]:  # Last 3 exchanges for context
            history_context += f"User: {entry.get('user_input', '')}\n"
            history_context += f"Assistant: {entry.get('final_response', '')}\n\n"
        history_context += "</conversation_history>\n"
    
    system_prompt = f"""You are an intention detection agent. Your job is to analyze the user's query and classify it into one of two categories:

{history_context}

<categories>
1. SCHEMA_INFO: Questions about database structure, table relationships, column definitions, what data is available, or how to find information
2. DATA_ANALYSIS: Requests for actual data queries, analysis, statistics, visualizations, or insights from the data
</categories>

<examples>
SCHEMA_INFO examples:
- "What tables are in the database?"
- "What columns does the orders table have?"
- "How are customers and orders related?"
- "What information is stored about products?"
- "Can I find customer location data?"
- "What does the customer_unique_id field mean?"

DATA_ANALYSIS examples:
- "Show me total sales by month"
- "What are the top 10 selling products?"
- "Calculate average order value"
- "Create a chart of customer distribution by state"
- "How many orders were delivered late?"
- "Compare revenue across different categories"
</examples>

<your_task>
Analyze the user's query below and respond with ONLY one of these two words:
- "SCHEMA_INFO" if the user wants information about the database structure
- "DATA_ANALYSIS" if the user wants to query, analyze, or visualize data

Do not provide any explanation, just return the classification.
</your_task>

<user_query>
{user_input}
</user_query>

Classification:"""
    
    return system_prompt
