  "sql_query": "SELECT \n    LEFT(op.payment_type, 10) AS payment_type,\n    op.payment_installments,\n    AVG(ABS(op.payment_value)) AS average_order_value\nFROM \n    orders o\nJOIN \n    order_payments op ON o.order_id = op.order_id\nWHERE \n    op.payment_installments > 1\nGROUP BY \n    payment_type, op.payment_installments\nORDER BY \n    payment_type, op.payment_installments;",
