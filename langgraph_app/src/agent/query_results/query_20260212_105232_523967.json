{
  "sql_query": "WITH order_posted_delivered AS (\n  SELECT\n    LEFT(o.order_id, 10) AS order_id_10,\n    o.order_delivered_carrier_date AS posted_ts,\n    o.order_delivered_customer_date AS delivered_ts\n  FROM orders o\n  WHERE o.order_delivered_carrier_date IS NOT NULL\n    AND o.order_delivered_customer_date IS NOT NULL\n),\norder_diffs AS (\n  SELECT\n    STRFTIME(CAST(opd.posted_ts AS DATE), '%Y-%m') AS month_posted,\n    ABS(DATE_DIFF('second', CAST(opd.posted_ts AS TIMESTAMP), CAST(opd.delivered_ts AS TIMESTAMP))) / 3600.0 AS time_diff_hours\n  FROM order_posted_delivered opd\n)\nSELECT\n  od.month_posted,\n  AVG(od.time_diff_hours) AS avg_time_hours\nFROM order_diffs od\nGROUP BY od.month_posted\nORDER BY od.month_posted;",
