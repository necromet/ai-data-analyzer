{
  "sql_query": "SELECT\n  LEFT(p.product_id, 10) AS product_id,\n  COALESCE(p.product_category_name, 'Unknown') AS product_name,\n  ABS(COUNT(oi.order_item_id)) AS total_quantity_sold,\n  ABS(SUM(oi.price)) AS total_revenue,\n  AVG(r.review_score) AS average_review_score\nFROM products p\nJOIN order_items oi\n  ON p.product_id = oi.product_id\nLEFT JOIN order_reviews r\n  ON oi.order_id = r.order_id\nGROUP BY\n  LEFT(p.product_id, 10),\n  COALESCE(p.product_category_name, 'Unknown')\nHAVING COUNT(oi.order_item_id) > 0\nORDER BY total_revenue DESC\nLIMIT 100;",
