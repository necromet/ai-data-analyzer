{
  "sql_query": "SELECT\n  CAST(o.order_purchase_timestamp AS DATE) AS order_purchase_date,\n  CASE\n    WHEN o.order_delivered_customer_date IS NULL THEN 'not_delivered'\n    WHEN CAST(o.order_delivered_customer_date AS DATE) > CAST(o.order_estimated_delivery_date AS DATE) THEN 'delayed'\n    ELSE 'on_time'\n  END AS delay_status,\n  COUNT(DISTINCT LEFT(o.order_id, 10)) AS orders_count\nFROM orders o\nWHERE CAST(o.order_purchase_timestamp AS DATE) BETWEEN CAST('2018-04-01' AS DATE) AND CAST('2018-04-30' AS DATE)\nGROUP BY\n  CAST(o.order_purchase_timestamp AS DATE),\n  CASE\n    WHEN o.order_delivered_customer_date IS NULL THEN 'not_delivered'\n    WHEN CAST(o.order_delivered_customer_date AS DATE) > CAST(o.order_estimated_delivery_date AS DATE) THEN 'delayed'\n    ELSE 'on_time'\n  END\nORDER BY order_purchase_date, delay_status;",
