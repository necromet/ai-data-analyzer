{
  "sql_query": "SELECT\n  c.customer_unique_id,\n  COUNT(DISTINCT o.order_id) AS order_count,\n  COALESCE(SUM(op.payment_value), 0) AS total_paid,\n  COALESCE(SUM(op.payment_value), 0) / NULLIF(COUNT(DISTINCT o.order_id), 0) AS avg_order_value,\n  MIN(o.order_purchase_timestamp) AS first_order_at,\n  MAX(o.order_purchase_timestamp) AS last_order_at\nFROM orders o\nJOIN customers c ON o.customer_id = c.customer_id\nLEFT JOIN order_payments op ON o.order_id = op.order_id\nGROUP BY c.customer_unique_id\nORDER BY order_count DESC, total_paid DESC\nLIMIT 3;",
