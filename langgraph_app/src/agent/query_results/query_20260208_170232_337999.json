  "sql_query": "SELECT\n  c.customer_unique_id AS cust_uid,\n  c.customer_city,\n  c.customer_state,\n  COUNT(o.order_id) AS order_count\nFROM customers AS c\nJOIN orders AS o\n  ON c.customer_id = o.customer_id\nGROUP BY 1,2,3\nORDER BY order_count DESC\nLIMIT 3;",
