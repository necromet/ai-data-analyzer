{
  "sql_query": "WITH\ncc AS (\n  SELECT\n    c.customer_unique_id AS cust_uid,\n    DATE_TRUNC('month', CAST(MIN(o.order_purchase_timestamp) AS TIMESTAMP))::date AS cohort_m\n  FROM orders o\n  JOIN customers c ON o.customer_id = c.customer_id\n  GROUP BY c.customer_unique_id\n),\nom AS (\n  SELECT\n    c.customer_unique_id AS cust_uid,\n    DATE_TRUNC('month', CAST(o.order_purchase_timestamp AS TIMESTAMP))::date AS order_m\n  FROM orders o\n  JOIN customers c ON o.customer_id = c.customer_id\n  WHERE o.order_purchase_timestamp IS NOT NULL\n),\nca AS (\n  SELECT\n    cc.cohort_m,\n    DATE_DIFF('month', cc.cohort_m, om.order_m) AS months_s,\n    om.cust_uid\n  FROM cc\n  JOIN om ON cc.cust_uid = om.cust_uid\n  WHERE DATE_DIFF('month', cc.cohort_m, om.order_m) >= 0\n),\ncs AS (\n  SELECT\n    cohort_m,\n    COUNT(DISTINCT cust_uid) AS cohort_sz\n  FROM cc\n  GROUP BY cohort_m\n),\nret AS (\n  SELECT\n    cohort_m,\n    months_s,\n    COUNT(DISTINCT cust_uid) AS retained_ct\n  FROM ca\n  GROUP BY cohort_m, months_s\n)\nSELECT\n  ret.cohort_m,\n  ret.months_s,\n  cs.cohort_sz,\n  ret.retained_ct,\n  CAST(ret.retained_ct AS DOUBLE) / NULLIF(cs.cohort_sz,0) AS retention_rt\nFROM ret\nJOIN cs USING (cohort_m)\nORDER BY ret.cohort_m DESC, ret.months_s;",
