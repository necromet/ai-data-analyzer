  "sql_query": "SELECT\n  customers.customer_unique_id AS cust_uid,\n  customers.customer_state AS state,\n  COUNT(DISTINCT orders.order_id) AS ord_cnt\nFROM orders\nJOIN customers\n  ON orders.customer_id = customers.customer_id\nGROUP BY customers.customer_unique_id, customers.customer_state\nORDER BY ord_cnt DESC\nLIMIT 3;",
