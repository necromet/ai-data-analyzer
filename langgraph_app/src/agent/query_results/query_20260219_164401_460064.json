{
  "sql_query": "SELECT\n  to_char(o.order_delivered_customer_date::date, 'YYYY-MM') AS delivery_month,\n  AVG(ABS((o.order_delivered_customer_date::date - o.order_estimated_delivery_date::date)))::numeric(10,2) AS avg_delivery_delay_days,\n  COUNT(o.order_id) AS orders_count\nFROM\n  orders o\nWHERE\n  o.order_delivered_customer_date IS NOT NULL\n  AND o.order_estimated_delivery_date IS NOT NULL\nGROUP BY\n  to_char(o.order_delivered_customer_date::date, 'YYYY-MM')\nORDER BY\n  delivery_month;",
