{
  "sql_query": "SELECT\n  LEFT(c.customer_id, 10) AS customer_id,\n  c.customer_unique_id,\n  c.customer_city,\n  ABS(SUM(COALESCE(oi.price, 0))) AS total_revenue\nFROM orders o\nJOIN order_items oi ON o.order_id = oi.order_id\nJOIN customers c ON o.customer_id = c.customer_id\nGROUP BY\n  LEFT(c.customer_id, 10),\n  c.customer_unique_id,\n  c.customer_city\nORDER BY total_revenue DESC\nLIMIT 3;",
