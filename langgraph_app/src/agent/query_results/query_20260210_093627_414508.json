{
  "sql_query": "WITH snapshot AS (\n  SELECT MAX(order_purchase_timestamp) AS snapshot_dt\n  FROM orders\n),\ncust_agg_base AS (\n  SELECT\n    c.customer_unique_id AS cust_uid,\n    MAX(o.order_purchase_timestamp) AS last_purchase_ts,\n    COUNT(DISTINCT o.order_id) AS frequency,\n    COALESCE(SUM(p.payment_value), 0.0) AS monetary\n  FROM customers c\n  JOIN orders o ON o.customer_id = c.customer_id\n  LEFT JOIN order_payments p ON p.order_id = o.order_id\n  GROUP BY c.customer_unique_id\n),\ncust_agg AS (\n  SELECT\n    b.cust_uid,\n    b.last_purchase_ts,\n    DATE_DIFF('day', CAST(b.last_purchase_ts AS DATE), CAST(s.snapshot_dt AS DATE)) AS recency,\n    b.frequency,\n    b.monetary\n  FROM cust_agg_base b\n  CROSS JOIN snapshot s\n),\nrfm_scores AS (\n  SELECT\n    cust_uid,\n    recency,\n    frequency,\n    monetary,\n    CAST(5 - NTILE(4) OVER (ORDER BY recency ASC) AS INTEGER) AS r_score,\n    CAST(5 - NTILE(4) OVER (ORDER BY frequency DESC) AS INTEGER) AS f_score,\n    CAST(5 - NTILE(4) OVER (ORDER BY monetary DESC) AS INTEGER) AS m_score,\n    CONCAT(\n      'R', CAST(5 - NTILE(4) OVER (ORDER BY recency ASC) AS VARCHAR),\n      'F', CAST(5 - NTILE(4) OVER (ORDER BY frequency DESC) AS VARCHAR),\n      'M', CAST(5 - NTILE(4) OVER (ORDER BY monetary DESC) AS VARCHAR)\n    ) AS rfm_segment\n  FROM cust_agg\n)\nSELECT\n  rfm_segment,\n  COUNT(*) AS customers_count,\n  ROUND(AVG(monetary), 2) AS avg_monetary,\n  ROUND(AVG(recency), 1) AS avg_recency\nFROM rfm_scores\nGROUP BY rfm_segment\nORDER BY customers_count DESC;",
