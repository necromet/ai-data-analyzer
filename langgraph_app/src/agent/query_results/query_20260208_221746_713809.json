{
  "sql_query": "SELECT\n  cust_uid,\n  COUNT(order_id) AS order_count\nFROM (\n  SELECT\n    c.customer_unique_id AS cust_uid,\n    o.order_id\n  FROM orders o\n  JOIN customers c\n    ON o.customer_id = c.customer_id\n) t\nGROUP BY cust_uid\nORDER BY order_count DESC\nLIMIT 3;",
