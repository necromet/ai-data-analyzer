{
  "sql_query": "WITH params AS (\n  SELECT\n    CAST(MAX(o.order_purchase_timestamp) AS DATE) AS max_purchase_date,\n    (CAST(MAX(o.order_purchase_timestamp) AS DATE) - INTERVAL '3 months')::DATE AS start_purchase_date\n  FROM orders o\n),\npayments_per_order AS (\n  SELECT\n    op.order_id,\n    ABS(SUM(op.payment_value)) AS order_total\n  FROM order_payments op\n  GROUP BY op.order_id\n)\nSELECT\n  CAST(o.order_purchase_timestamp AS DATE) AS order_date,\n  ABS(AVG(pp.order_total))::numeric AS average_order_value\nFROM orders o\nJOIN payments_per_order pp ON o.order_id = pp.order_id\nJOIN params p ON 1=1\nWHERE\n  CAST(o.order_purchase_timestamp AS DATE) >= p.start_purchase_date\n  AND CAST(o.order_purchase_timestamp AS DATE) <= p.max_purchase_date\nGROUP BY CAST(o.order_purchase_timestamp AS DATE)\nORDER BY CAST(o.order_purchase_timestamp AS DATE) ASC;",
