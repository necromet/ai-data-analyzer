{
  "sql_query": "SELECT\n  COALESCE(pcat.product_category_name_english, 'Unknown') AS product_category,\n  ABS(SUM(oi.price + oi.freight_value)) AS total_revenue,\n  COUNT(DISTINCT oi.order_id) AS total_order_volume\nFROM order_items oi\nJOIN products p ON oi.product_id = p.product_id\nLEFT JOIN product_category_translation pcat ON p.product_category_name = pcat.product_category_name\nGROUP BY COALESCE(pcat.product_category_name_english, 'Unknown')\nORDER BY total_revenue DESC;",
