{
  "sql_query": "WITH max_dt AS (\n  SELECT DATE_TRUNC('month', MAX(o.order_purchase_timestamp))::date AS max_month_start\n  FROM orders o\n),\nmonths AS (\n  SELECT generate_series(\n    (m.max_month_start - INTERVAL '23 months')::date,\n    m.max_month_start::date,\n    INTERVAL '1 month'\n  )::date AS month_start\n  FROM max_dt m\n),\npayments_per_order AS (\n  SELECT\n    op.order_id,\n    ABS(SUM(op.payment_value)) AS order_payment_total\n  FROM order_payments op\n  GROUP BY op.order_id\n),\norder_price_totals AS (\n  SELECT\n    oi.order_id,\n    ABS(SUM(oi.price)) AS order_price_total\n  FROM order_items oi\n  GROUP BY oi.order_id\n),\nitem_alloc AS (\n  SELECT\n    oi.order_id,\n    oi.product_id,\n    COALESCE(pct.product_category_name_english, 'Unknown') AS category_name,\n    DATE_TRUNC('month', o.order_purchase_timestamp)::date AS month_start,\n    -- allocate payment value to item proportionally by item price within the order\n    CASE\n      WHEN opt.order_price_total > 0 THEN (pp.order_payment_total * (ABS(oi.price) / opt.order_price_total))\n      ELSE 0\n    END AS allocated_payment\n  FROM order_items oi\n  JOIN orders o ON o.order_id = oi.order_id\n  LEFT JOIN payments_per_order pp ON pp.order_id = oi.order_id\n  LEFT JOIN order_price_totals opt ON opt.order_id = oi.order_id\n  LEFT JOIN products p ON p.product_id = oi.product_id\n  LEFT JOIN product_category_translation pct ON pct.product_category_name = p.product_category_name\n  WHERE o.order_purchase_timestamp IS NOT NULL\n    AND o.order_purchase_timestamp >= (SELECT (max_month_start - INTERVAL '23 months')::date FROM max_dt)\n    AND o.order_purchase_timestamp <  ((SELECT max_month_start FROM max_dt) + INTERVAL '1 month')\n),\ncategory_month_sales AS (\n  SELECT\n    category_name,\n    month_start,\n    ABS(SUM(allocated_payment)) AS monthly_sales\n  FROM item_alloc\n  GROUP BY category_name, month_start\n),\ntop_categories AS (\n  SELECT category_name\n  FROM (\n    SELECT category_name, SUM(monthly_sales) AS total_sales\n    FROM category_month_sales\n    GROUP BY category_name\n    ORDER BY total_sales DESC\n    LIMIT 10\n  ) t\n),\ncategory_month_grid AS (\n  SELECT tc.category_name, m.month_start\n  FROM top_categories tc\n  CROSS JOIN months m\n)\nSELECT\n  cmg.category_name,\n  TO_CHAR(cmg.month_start, 'YYYY-MM') AS year_month,\n  COALESCE(cms.monthly_sales, 0)::numeric(18,2) AS monthly_sales\nFROM category_month_grid cmg\nLEFT JOIN category_month_sales cms\n  ON cms.category_name = cmg.category_name\n  AND cms.month_start = cmg.month_start\nORDER BY cmg.category_name, cmg.month_start;",
