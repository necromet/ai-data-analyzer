  "sql_query": "SELECT\n  c.customer_unique_id AS custuniq,\n  c.customer_state AS custstate,\n  COUNT(o.order_id) AS order_cnt\nFROM orders AS o\nJOIN customers AS c\n  ON o.customer_id = c.customer_id\nGROUP BY\n  c.customer_unique_id,\n  c.customer_state\nORDER BY\n  order_cnt DESC\nLIMIT 3;",
