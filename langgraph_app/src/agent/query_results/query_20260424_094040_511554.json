{
  "sql_query": "SELECT\n  CASE\n    WHEN COALESCE(op.payment_installments, 0) > 1 THEN 'installment'\n    ELSE 'single_payment'\n  END AS installment_type,\n  COUNT(*) AS count,\n  ROUND((COUNT(*)::numeric / SUM(COUNT(*)) OVER ()) * 100, 2) AS percentage_of_credit_card_payments\nFROM order_payments op\nWHERE op.payment_type = 'credit_card'\nGROUP BY 1\nORDER BY 1;",
