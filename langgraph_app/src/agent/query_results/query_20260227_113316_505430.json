{
  "sql_query": "SELECT\n  LEFT(p.product_id, 10) AS product_id,\n  COALESCE(p.product_category_name, 'unknown') AS product_name,\n  ABS(SUM(oi.price))::NUMERIC(20,2) AS total_revenue,\n  COUNT(oi.order_item_id)::INT AS total_quantity_sold\nFROM order_items oi\nJOIN products p\n  ON oi.product_id = p.product_id\nGROUP BY LEFT(p.product_id, 10), COALESCE(p.product_category_name, 'unknown')\nORDER BY total_revenue DESC\nLIMIT 10;",
