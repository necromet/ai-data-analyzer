{
  "sql_query": "WITH geo AS (\n  SELECT\n    g.geolocation_zip_code_prefix AS zip_code_prefix,\n    ANY_VALUE(g.geolocation_city) AS city,\n    ANY_VALUE(g.geolocation_state) AS state\n  FROM geolocation g\n  GROUP BY\n    g.geolocation_zip_code_prefix\n)\nSELECT\n  'state' AS location_type,\n  COALESCE(geo.state, c.customer_state) AS location_name,\n  COUNT(DISTINCT c.customer_unique_id) AS customer_count\nFROM customers c\nLEFT JOIN geo\n  ON c.customer_zip_code_prefix = geo.zip_code_prefix\nGROUP BY\n  location_type,\n  location_name\nORDER BY\n  location_type,\n  customer_count DESC,\n  location_name ASC;",
