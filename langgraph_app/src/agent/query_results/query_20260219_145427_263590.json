{
  "sql_query": "WITH first_purchases AS (\n  SELECT\n    c.customer_unique_id,\n    MIN(CAST(o.order_purchase_timestamp AS DATE)) AS first_purchase_date\n  FROM orders o\n  JOIN customers c ON o.customer_id = c.customer_id\n  WHERE o.order_purchase_timestamp IS NOT NULL\n  GROUP BY c.customer_unique_id\n),\nmonthly_active AS (\n  SELECT\n    date_trunc('month', CAST(o.order_purchase_timestamp AS DATE))::date AS month_start,\n    COUNT(DISTINCT c.customer_unique_id) AS active_customers\n  FROM orders o\n  JOIN customers c ON o.customer_id = c.customer_id\n  WHERE CAST(o.order_purchase_timestamp AS DATE) BETWEEN CAST('2016-09-01' AS DATE) AND CAST('2018-10-31' AS DATE)\n  GROUP BY 1\n),\nmonths AS (\n  SELECT generate_series(\n    CAST('2016-09-01' AS DATE),\n    CAST('2018-10-01' AS DATE),\n    INTERVAL '1 month'\n  )::date AS month_start\n)\nSELECT\n  m.month_start,\n  COALESCE(ma.active_customers, 0) AS active_customers,\n  (\n    SELECT COUNT(*)\n    FROM first_purchases fp\n    WHERE fp.first_purchase_date <= (m.month_start + INTERVAL '1 month' - INTERVAL '1 day')::date\n  ) AS cumulative_customers\nFROM months m\nLEFT JOIN monthly_active ma ON ma.month_start = m.month_start\nORDER BY m.month_start;",
