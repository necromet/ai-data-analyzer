{
  "sql_query": "WITH per_order_payment AS (\n  SELECT\n    order_id,\n    payment_type,\n    SUM(payment_value) AS order_payment_value,\n    MAX(payment_installments) AS order_payment_installments\n  FROM order_payments\n  GROUP BY order_id, payment_type\n),\nagg AS (\n  SELECT\n    payment_type,\n    COUNT(DISTINCT order_id) AS orders_count,\n    SUM(order_payment_value) AS total_payment_value,\n    AVG(order_payment_value) AS avg_payment_value_per_order,\n    AVG(order_payment_installments) AS avg_payment_installments\n  FROM per_order_payment\n  GROUP BY payment_type\n)\nSELECT\n  payment_type,\n  orders_count,\n  total_payment_value,\n  avg_payment_value_per_order,\n  avg_payment_installments\nFROM agg\nORDER BY total_payment_value DESC;",
