{
  "sql_query": "WITH freight_by_order AS (\n  SELECT\n    oi.order_id AS order_id,\n    ABS(SUM(oi.freight_value)) AS order_freight_value\n  FROM order_items oi\n  GROUP BY oi.order_id\n),\npayments_by_order AS (\n  SELECT\n    op.order_id AS order_id,\n    ABS(SUM(op.payment_value)) AS order_payment_value\n  FROM order_payments op\n  GROUP BY op.order_id\n)\nSELECT\n  c.customer_state AS state,\n  ABS(SUM(COALESCE(fbo.order_freight_value, 0))) AS total_freight_value,\n  ABS(SUM(pbo.order_payment_value)) AS total_order_value,\n  100.0 * ABS(SUM(COALESCE(fbo.order_freight_value, 0))) / NULLIF(ABS(SUM(pbo.order_payment_value)), 0) AS freight_pct_of_order\nFROM orders o\nJOIN customers c\n  ON c.customer_id = o.customer_id\nLEFT JOIN freight_by_order fbo\n  ON fbo.order_id = o.order_id\nLEFT JOIN payments_by_order pbo\n  ON pbo.order_id = o.order_id\nGROUP BY\n  c.customer_state\nHAVING\n  NULLIF(ABS(SUM(pbo.order_payment_value)), 0) IS NOT NULL\nORDER BY\n  freight_pct_of_order DESC,\n  c.customer_state ASC;",
