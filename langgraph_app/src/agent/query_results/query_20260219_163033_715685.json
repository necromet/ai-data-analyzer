{
  "sql_query": "SELECT\n  DATE_TRUNC('month', CAST(o.order_delivered_customer_date AS DATE))::DATE AS delivery_month,\n  COUNT(DISTINCT o.order_id) AS delayed_orders_count\nFROM\n  orders o\nWHERE\n  o.order_delivered_customer_date IS NOT NULL\n  AND o.order_estimated_delivery_date IS NOT NULL\n  AND CAST(o.order_delivered_customer_date AS DATE) > CAST(o.order_estimated_delivery_date AS DATE)\nGROUP BY\n  DATE_TRUNC('month', CAST(o.order_delivered_customer_date AS DATE))\nORDER BY\n  delivery_month;",
