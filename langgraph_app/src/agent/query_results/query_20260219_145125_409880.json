{
  "sql_query": "WITH months AS (\n  SELECT DISTINCT date_trunc('month', o.order_purchase_timestamp) AS month_start\n  FROM orders o\n  WHERE o.order_purchase_timestamp IS NOT NULL\n)\nSELECT\n  m.month_start::date AS month_start,\n  COALESCE((\n    SELECT COUNT(DISTINCT cu.customer_unique_id)\n    FROM orders o2\n    JOIN customers cu ON o2.customer_id = cu.customer_id\n    WHERE date_trunc('month', o2.order_purchase_timestamp) = m.month_start\n      AND o2.order_purchase_timestamp IS NOT NULL\n  ), 0) AS active_customers,\n  COALESCE((\n    SELECT COUNT(DISTINCT cu2.customer_unique_id)\n    FROM orders o3\n    JOIN customers cu2 ON o3.customer_id = cu2.customer_id\n    WHERE o3.order_purchase_timestamp IS NOT NULL\n      AND o3.order_purchase_timestamp <= (m.month_start + INTERVAL '1 month' - INTERVAL '1 second')\n  ), 0) AS cumulative_customers,\n  CASE\n    WHEN COALESCE((\n      SELECT COUNT(DISTINCT cu2.customer_unique_id)\n      FROM orders o3\n      JOIN customers cu2 ON o3.customer_id = cu2.customer_id\n      WHERE o3.order_purchase_timestamp IS NOT NULL\n        AND o3.order_purchase_timestamp <= (m.month_start + INTERVAL '1 month' - INTERVAL '1 second')\n    ), 0) = 0 THEN 0.0\n    ELSE ROUND(\n      100.0 * COALESCE((\n        SELECT COUNT(DISTINCT cu.customer_unique_id)\n        FROM orders o2\n        JOIN customers cu ON o2.customer_id = cu.customer_id\n        WHERE date_trunc('month', o2.order_purchase_timestamp) = m.month_start\n          AND o2.order_purchase_timestamp IS NOT NULL\n      ), 0)::numeric /\n      COALESCE((\n        SELECT COUNT(DISTINCT cu2.customer_unique_id)\n        FROM orders o3\n        JOIN customers cu2 ON o3.customer_id = cu2.customer_id\n        WHERE o3.order_purchase_timestamp IS NOT NULL\n          AND o3.order_purchase_timestamp <= (m.month_start + INTERVAL '1 month' - INTERVAL '1 second')\n      ), 0)::numeric, 2)\n  END AS pct_active_of_cumulative\nFROM months m\nORDER BY m.month_start;",
