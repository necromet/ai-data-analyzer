{
  "sql_query": "WITH order_payment_totals AS (\n  SELECT\n    order_id,\n    SUM(payment_value) AS order_payment_value\n  FROM order_payments\n  GROUP BY order_id\n),\norder_review_scores AS (\n  SELECT\n    order_id,\n    AVG(review_score) AS order_review_score\n  FROM order_reviews\n  GROUP BY order_id\n)\nSELECT\n  c.customer_unique_id,\n  COUNT(DISTINCT o.order_id) AS order_count,\n  SUM(opt.order_payment_value) AS total_spent,\n  AVG(opt.order_payment_value) AS avg_order_value,\n  AVG(ors.order_review_score) AS avg_review_score,\n  MIN(o.order_purchase_timestamp) AS first_order_date,\n  MAX(o.order_purchase_timestamp) AS last_order_date,\n  MAX(c.customer_city) AS customer_city,\n  MAX(c.customer_state) AS customer_state\nFROM orders o\nJOIN customers c ON o.customer_id = c.customer_id\nLEFT JOIN order_payment_totals opt ON o.order_id = opt.order_id\nLEFT JOIN order_review_scores ors ON o.order_id = ors.order_id\nGROUP BY c.customer_unique_id\nORDER BY order_count DESC\nLIMIT 3;",
