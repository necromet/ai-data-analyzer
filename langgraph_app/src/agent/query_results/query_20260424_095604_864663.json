{
  "sql_query": "SELECT\n  g.installments AS payment_installments,\n  COALESCE(p.order_count, 0) AS order_count\nFROM\n  (SELECT generate_series(1,5) AS installments) g\nLEFT JOIN (\n  SELECT\n    op.payment_installments,\n    COUNT(DISTINCT op.order_id) AS order_count\n  FROM\n    order_payments op\n  JOIN\n    orders o ON op.order_id = o.order_id\n  WHERE\n    op.payment_installments BETWEEN 1 AND 5\n  GROUP BY\n    op.payment_installments\n) p\n  ON p.payment_installments = g.installments\nORDER BY\n  g.installments;",
