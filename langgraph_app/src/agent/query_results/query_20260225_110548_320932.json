{
  "sql_query": "SELECT\n  LEFT(o.order_id, 10) AS order_id,\n  MAX(o.order_delivered_carrier_date)            AS order_delivered_carrier_date,\n  MAX(o.order_delivered_customer_date)           AS order_delivered_customer_date,\n  ABS( (EXTRACT(EPOCH FROM (MAX(o.order_delivered_customer_date) - MAX(o.order_delivered_carrier_date)))) / 86400 )::INT AS duration_days\nFROM\n  orders o\nWHERE\n  o.order_delivered_carrier_date IS NOT NULL\n  AND o.order_delivered_customer_date IS NOT NULL\nGROUP BY\n  LEFT(o.order_id, 10)\nORDER BY\n  duration_days DESC\nLIMIT 10;",
