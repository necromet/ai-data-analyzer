{
  "sql_query": "SELECT\n  LEFT(t.seller_id, 10) AS seller_id,\n  t.seller_zip_code_prefix,\n  t.total_deliveries,\n  t.late_deliveries,\n  CASE WHEN t.total_deliveries = 0 THEN 0::numeric ELSE (t.late_deliveries::numeric / t.total_deliveries) END AS late_delivery_rate\nFROM (\n  SELECT\n    oi.seller_id AS seller_id,\n    s.seller_zip_code_prefix AS seller_zip_code_prefix,\n    COUNT(DISTINCT CASE WHEN o.order_delivered_customer_date IS NOT NULL AND o.order_estimated_delivery_date IS NOT NULL THEN o.order_id END) AS total_deliveries,\n    COUNT(DISTINCT CASE WHEN o.order_delivered_customer_date IS NOT NULL\n                        AND o.order_estimated_delivery_date IS NOT NULL\n                        AND CAST(o.order_delivered_customer_date AS DATE) > CAST(o.order_estimated_delivery_date AS DATE)\n                   THEN o.order_id END) AS late_deliveries\n  FROM order_items oi\n  JOIN orders o ON oi.order_id = o.order_id\n  JOIN sellers s ON oi.seller_id = s.seller_id\n  GROUP BY oi.seller_id, s.seller_zip_code_prefix\n) t\nWHERE t.total_deliveries >= 10\nORDER BY late_delivery_rate DESC\nLIMIT 50;",
