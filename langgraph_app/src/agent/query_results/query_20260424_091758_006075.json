{
  "sql_query": "WITH year_months AS (\n  SELECT\n    EXTRACT(YEAR FROM o.order_purchase_timestamp)::INT AS year,\n    EXTRACT(MONTH FROM o.order_purchase_timestamp)::INT AS month,\n    COALESCE(p.payment_value, 0)::NUMERIC AS payment_value\n  FROM orders o\n  JOIN order_payments p ON p.order_id = o.order_id\n  WHERE o.order_purchase_timestamp IS NOT NULL\n),\ncomplete_years AS (\n  SELECT\n    ym.year\n  FROM year_months ym\n  GROUP BY ym.year\n  HAVING COUNT(DISTINCT ym.month) = 12\n  ORDER BY ym.year DESC\n  LIMIT 2\n)\nSELECT\n  ym.year,\n  ym.month,\n  ABS(SUM(ym.payment_value)) AS total_revenue\nFROM year_months ym\nWHERE ym.year IN (SELECT year FROM complete_years)\nGROUP BY ym.year, ym.month\nORDER BY ym.year DESC, ym.month;",
