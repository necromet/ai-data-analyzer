{
  "sql_query": "WITH per_cat AS (\n  SELECT\n    pct.product_category_name_english AS product_category,\n    SUM(oi.price + oi.freight_value) AS total_revenue,\n    COUNT(*) AS order_items_count,\n    COUNT(DISTINCT oi.order_id) AS unique_orders_count\n  FROM order_items AS oi\n  JOIN products AS p ON oi.product_id = p.product_id\n  LEFT JOIN product_category_translation AS pct ON p.product_category_name = pct.product_category_name\n  GROUP BY pct.product_category_name_english\n),\ngrand AS (\n  SELECT\n    SUM(total_revenue) AS grand_total,\n    SUM(order_items_count) AS total_order_items_count,\n    SUM(unique_orders_count) AS total_unique_orders_count\n  FROM per_cat\n),\ntop20 AS (\n  SELECT *\n  FROM per_cat\n  ORDER BY total_revenue DESC\n  LIMIT 20\n),\ncombined AS (\n  SELECT\n    product_category,\n    total_revenue,\n    order_items_count,\n    unique_orders_count,\n    total_revenue / NULLIF(grand.grand_total, 0) AS pct_of_total_revenue\n  FROM top20\n  CROSS JOIN grand\n\n  UNION ALL\n\n  SELECT\n    'Grand Total' AS product_category,\n    grand.grand_total AS total_revenue,\n    grand.total_order_items_count AS order_items_count,\n    grand.total_unique_orders_count AS unique_orders_count,\n    1.0 AS pct_of_total_revenue\n  FROM grand\n)\nSELECT\n  product_category,\n  total_revenue,\n  order_items_count,\n  unique_orders_count,\n  pct_of_total_revenue\nFROM combined\nORDER BY CASE WHEN product_category = 'Grand Total' THEN 2 ELSE 1 END, total_revenue DESC;",
