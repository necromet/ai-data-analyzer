{
  "sql_query": "WITH order_item_revenue AS (\n  SELECT\n    oi.order_id,\n    SUM(ABS(oi.price) * 1) AS order_revenue\n  FROM order_items AS oi\n  GROUP BY oi.order_id\n),\nmonthly_revenue AS (\n  SELECT\n    STRFTIME(DATE_TRUNC('month', CAST(o.order_purchase_timestamp AS TIMESTAMP)), '%Y-%m') AS month,\n    SUM(ABS(COALESCE(oir.order_revenue, 0))) AS total_revenue\n  FROM orders AS o\n  LEFT JOIN order_item_revenue AS oir\n    ON oir.order_id = o.order_id\n  WHERE o.order_purchase_timestamp IS NOT NULL\n  GROUP BY 1\n)\nSELECT\n  mr.month,\n  mr.total_revenue\nFROM monthly_revenue AS mr\nORDER BY mr.month DESC\nLIMIT 12;",
