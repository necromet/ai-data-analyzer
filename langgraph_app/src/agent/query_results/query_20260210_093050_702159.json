{
  "sql_query": "WITH first_purchase AS (\n  SELECT\n    c.customer_unique_id AS cust_uid,\n    CAST(date_trunc('month', CAST(MIN(o.order_purchase_timestamp) AS TIMESTAMP)) AS DATE) AS cohort_month\n  FROM customers c\n  JOIN orders o ON o.customer_id = c.customer_id\n  GROUP BY c.customer_unique_id\n),\ncust_months AS (\n  SELECT DISTINCT\n    fp.cust_uid,\n    fp.cohort_month,\n    date_diff('month', fp.cohort_month, CAST(date_trunc('month', CAST(o.order_purchase_timestamp AS TIMESTAMP)) AS DATE)) AS months_since\n  FROM first_purchase fp\n  JOIN customers c ON c.customer_unique_id = fp.cust_uid\n  JOIN orders o ON o.customer_id = c.customer_id\n  WHERE date_diff('month', fp.cohort_month, CAST(date_trunc('month', CAST(o.order_purchase_timestamp AS TIMESTAMP)) AS DATE)) BETWEEN 0 AND 12\n)\nSELECT\n  strftime('%Y-%m', fp.cohort_month) AS cohort,\n  COUNT(DISTINCT fp.cust_uid) AS cohort_size,\n  ROUND(100.0 * COUNT(DISTINCT CASE WHEN cm.months_since = 0 THEN cm.cust_uid END) / NULLIF(COUNT(DISTINCT fp.cust_uid),0),2) AS month_0,\n  ROUND(100.0 * COUNT(DISTINCT CASE WHEN cm.months_since = 1 THEN cm.cust_uid END) / NULLIF(COUNT(DISTINCT fp.cust_uid),0),2) AS month_1,\n  ROUND(100.0 * COUNT(DISTINCT CASE WHEN cm.months_since = 2 THEN cm.cust_uid END) / NULLIF(COUNT(DISTINCT fp.cust_uid),0),2) AS month_2,\n  ROUND(100.0 * COUNT(DISTINCT CASE WHEN cm.months_since = 3 THEN cm.cust_uid END) / NULLIF(COUNT(DISTINCT fp.cust_uid),0),2) AS month_3,\n  ROUND(100.0 * COUNT(DISTINCT CASE WHEN cm.months_since = 4 THEN cm.cust_uid END) / NULLIF(COUNT(DISTINCT fp.cust_uid),0),2) AS month_4,\n  ROUND(100.0 * COUNT(DISTINCT CASE WHEN cm.months_since = 5 THEN cm.cust_uid END) / NULLIF(COUNT(DISTINCT fp.cust_uid),0),2) AS month_5,\n  ROUND(100.0 * COUNT(DISTINCT CASE WHEN cm.months_since = 6 THEN cm.cust_uid END) / NULLIF(COUNT(DISTINCT fp.cust_uid),0),2) AS month_6,\n  ROUND(100.0 * COUNT(DISTINCT CASE WHEN cm.months_since = 7 THEN cm.cust_uid END) / NULLIF(COUNT(DISTINCT fp.cust_uid),0),2) AS month_7,\n  ROUND(100.0 * COUNT(DISTINCT CASE WHEN cm.months_since = 8 THEN cm.cust_uid END) / NULLIF(COUNT(DISTINCT fp.cust_uid),0),2) AS month_8,\n  ROUND(100.0 * COUNT(DISTINCT CASE WHEN cm.months_since = 9 THEN cm.cust_uid END) / NULLIF(COUNT(DISTINCT fp.cust_uid),0),2) AS month_9,\n  ROUND(100.0 * COUNT(DISTINCT CASE WHEN cm.months_since = 10 THEN cm.cust_uid END) / NULLIF(COUNT(DISTINCT fp.cust_uid),0),2) AS month_10,\n  ROUND(100.0 * COUNT(DISTINCT CASE WHEN cm.months_since = 11 THEN cm.cust_uid END) / NULLIF(COUNT(DISTINCT fp.cust_uid),0),2) AS month_11,\n  ROUND(100.0 * COUNT(DISTINCT CASE WHEN cm.months_since = 12 THEN cm.cust_uid END) / NULLIF(COUNT(DISTINCT fp.cust_uid),0),2) AS month_12\nFROM first_purchase fp\nLEFT JOIN cust_months cm ON fp.cust_uid = cm.cust_uid\nGROUP BY fp.cohort_month\nORDER BY fp.cohort_month;",
