{
  "sql_query": "SELECT\n  customers.customer_unique_id AS cust_uid,\n  customers.customer_city         AS city,\n  customers.customer_state        AS state,\n  geolocation.geolocation_lat     AS lat,\n  geolocation.geolocation_lng     AS lng,\n  COUNT(DISTINCT orders.order_id) AS ord_cnt,\n  SUM(order_payments.payment_value) AS tot_rev\nFROM customers\nJOIN orders ON customers.customer_id = orders.customer_id\nJOIN order_payments ON orders.order_id = order_payments.order_id\nLEFT JOIN geolocation ON customers.customer_zip_code_prefix = geolocation.geolocation_zip_code_prefix\nGROUP BY\n  customers.customer_unique_id,\n  customers.customer_city,\n  customers.customer_state,\n  geolocation.geolocation_lat,\n  geolocation.geolocation_lng\nORDER BY ord_cnt DESC, tot_rev DESC\nLIMIT 3;",
