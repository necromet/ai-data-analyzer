{
  "sql_query": "SELECT\n  COALESCE(pct.product_category_name_english, 'Unknown') AS product_category_name_english,\n  ROUND(AVG(p.product_weight_g)::numeric, 2) AS avg_product_weight_g,\n  COUNT(oi.order_item_id) AS items_sold,\n  COUNT(DISTINCT c.customer_unique_id) AS distinct_customers\nFROM orders o\nJOIN order_items oi ON o.order_id = oi.order_id\nJOIN products p ON oi.product_id = p.product_id\nLEFT JOIN product_category_translation pct ON p.product_category_name = pct.product_category_name\nJOIN customers c ON o.customer_id = c.customer_id\nWHERE o.order_purchase_timestamp >= CAST('2018-04-01' AS timestamp)\n  AND o.order_purchase_timestamp < CAST('2018-05-01' AS timestamp)\nGROUP BY COALESCE(pct.product_category_name_english, 'Unknown')\nORDER BY items_sold DESC;",
