{
  "sql_query": "SELECT\n  EXTRACT(MONTH FROM CAST(o.order_purchase_timestamp AS DATE)) AS month,\n  STRFTIME(CAST(o.order_purchase_timestamp AS DATE), '%A') AS weekday,\n  ABS(SUM(op.payment_value)) AS total_sales\nFROM orders AS o\nJOIN order_payments AS op\n  ON op.order_id = o.order_id\nWHERE o.order_status = 'delivered'\n  AND o.order_purchase_timestamp IS NOT NULL\nGROUP BY\n  month,\n  weekday\nORDER BY\n  month,\n  weekday;",
