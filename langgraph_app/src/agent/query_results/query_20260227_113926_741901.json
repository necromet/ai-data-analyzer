{
  "sql_query": "SELECT\n  LEFT(p.product_id, 10) AS product_id,\n  COALESCE(p.product_category_name, '') AS product_name,\n  ABS(SUM(oi.price)) AS total_sales,\n  COUNT(oi.order_item_id) AS total_units_sold\nFROM\n  order_items oi\nJOIN\n  products p\n  ON oi.product_id = p.product_id\nGROUP BY\n  LEFT(p.product_id, 10),\n  COALESCE(p.product_category_name, '')\nORDER BY\n  total_sales DESC\nLIMIT 10;",
