{
  "sql_query": "WITH ord_pay AS (\n  SELECT order_id, SUM(payment_value) AS order_value\n  FROM order_payments\n  GROUP BY order_id\n),\nanchor AS (\n  SELECT CAST(MAX(order_purchase_timestamp) AS DATE) AS max_dt\n  FROM orders\n),\ncust_metrics AS (\n  SELECT\n    c.customer_unique_id AS cust_uid,\n    CAST(MAX(o.order_purchase_timestamp) AS DATE) AS last_pur,\n    COUNT(DISTINCT o.order_id) AS freq,\n    SUM(op.order_value) AS monetary\n  FROM orders o\n  JOIN ord_pay op USING (order_id)\n  JOIN customers c ON o.customer_id = c.customer_id\n  GROUP BY c.customer_unique_id\n),\nrfm_scores AS (\n  SELECT\n    cm.cust_uid,\n    cm.last_pur,\n    date_diff('day', cm.last_pur, a.max_dt) AS recency,\n    cm.freq,\n    cm.monetary,\n    6 - NTILE(5) OVER (ORDER BY date_diff('day', cm.last_pur, a.max_dt) ASC) AS r_quint,\n    6 - NTILE(5) OVER (ORDER BY cm.freq ASC) AS f_quint,\n    6 - NTILE(5) OVER (ORDER BY cm.monetary ASC) AS m_quint\n  FROM cust_metrics cm\n  CROSS JOIN anchor a\n)\nSELECT\n  r_quint AS r_q,\n  f_quint AS f_q,\n  m_quint AS m_q,\n  COUNT(*) AS cust_cnt,\n  AVG(monetary) AS avg_ltv,\n  CASE WHEN SUM(freq)=0 THEN NULL ELSE SUM(monetary)/SUM(freq) END AS avg_ord_val\nFROM rfm_scores\nGROUP BY r_quint, f_quint, m_quint\nORDER BY r_q DESC, f_q DESC, m_q DESC;",
