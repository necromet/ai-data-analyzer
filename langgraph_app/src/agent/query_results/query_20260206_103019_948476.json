{
  "sql_query": "SELECT\n  c.customer_unique_id,\n  COUNT(o.order_id) AS order_count,\n  c.customer_city,\n  c.customer_state\nFROM customers c\nJOIN orders o ON o.customer_id = c.customer_id\nGROUP BY c.customer_unique_id, c.customer_city, c.customer_state\nORDER BY order_count DESC\nLIMIT 3;",
