{
  "sql_query": "SELECT\n  to_char(date_trunc('month', o.order_purchase_timestamp)::date, 'YYYY-MM') AS month,\n  ABS(SUM(p.payment_value)) AS total_revenue\nFROM orders o\nJOIN order_payments p ON p.order_id = o.order_id\nWHERE\n  o.order_purchase_timestamp >= (\n    SELECT date_trunc('month', MAX(o2.order_purchase_timestamp)) - INTERVAL '11 months' FROM orders o2\n  )\n  AND o.order_purchase_timestamp < (\n    SELECT date_trunc('month', MAX(o2.order_purchase_timestamp)) + INTERVAL '1 month' FROM orders o2\n  )\nGROUP BY date_trunc('month', o.order_purchase_timestamp)\nORDER BY month ASC;",
