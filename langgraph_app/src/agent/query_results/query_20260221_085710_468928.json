{
  "sql_query": "SELECT\n  TO_CHAR(CAST(o.order_purchase_timestamp AS DATE), 'YYYY-MM') AS month,\n  COUNT(DISTINCT LEFT(o.order_id, 10)) AS total_orders,\n  ABS(SUM(COALESCE(op.payment_value, 0))) AS total_revenue,\n  (ABS(SUM(COALESCE(op.payment_value, 0))) / NULLIF(COUNT(DISTINCT LEFT(o.order_id, 10)), 0)::numeric) AS avg_order_value\nFROM\n  orders o\n  JOIN order_payments op ON o.order_id = op.order_id\nWHERE\n  o.order_purchase_timestamp IS NOT NULL\nGROUP BY\n  TO_CHAR(CAST(o.order_purchase_timestamp AS DATE), 'YYYY-MM')\nORDER BY\n  month ASC;",
