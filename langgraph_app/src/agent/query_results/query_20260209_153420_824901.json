{
  "sql_query": "WITH ord AS (\n  SELECT order_id AS ord_id,\n         customer_id AS cust_id\n  FROM orders\n),\ncust AS (\n  SELECT customer_id AS cust_id,\n         customer_unique_id AS cust_unq\n  FROM customers\n),\npay AS (\n  SELECT order_id AS ord_id,\n         SUM(payment_value) AS pay_sum\n  FROM order_payments\n  GROUP BY order_id\n)\nSELECT\n  c.cust_unq AS cust_unq,\n  COUNT(DISTINCT o.ord_id) AS total_ord,\n  COALESCE(SUM(p.pay_sum), 0) AS total_sal,\n  CASE WHEN COUNT(DISTINCT o.ord_id)=0 THEN NULL ELSE COALESCE(SUM(p.pay_sum),0)/COUNT(DISTINCT o.ord_id) END AS avg_ord\nFROM ord o\nJOIN cust c ON o.cust_id = c.cust_id\nLEFT JOIN pay p ON o.ord_id = p.ord_id\nGROUP BY c.cust_unq\nORDER BY total_ord DESC\nLIMIT 3;",
