{
  "sql_query": "WITH params AS (\n  SELECT\n    MAX(o.order_purchase_timestamp) AS max_purchase_ts,\n    (MAX(o.order_purchase_timestamp) - INTERVAL '24 months') AS start_ts\n  FROM orders o\n),\ntop_categories AS (\n  SELECT\n    COALESCE(pct.product_category_name_english, 'Unknown') AS category_name,\n    ABS(SUM(oi.price)) AS total_sales\n  FROM orders o\n  JOIN order_items oi ON o.order_id = oi.order_id\n  JOIN products p ON oi.product_id = p.product_id\n  LEFT JOIN product_category_translation pct ON p.product_category_name = pct.product_category_name\n  JOIN params ON TRUE\n  WHERE o.order_purchase_timestamp >= params.start_ts\n  GROUP BY COALESCE(pct.product_category_name_english, 'Unknown')\n  ORDER BY total_sales DESC\n  LIMIT 10\n)\nSELECT\n  to_char(DATE_TRUNC('month', o.order_purchase_timestamp), 'YYYY-MM') AS year_month,\n  tc.category_name,\n  ABS(SUM(oi.price)) AS monthly_sales\nFROM orders o\nJOIN order_items oi ON o.order_id = oi.order_id\nJOIN products p ON oi.product_id = p.product_id\nLEFT JOIN product_category_translation pct ON p.product_category_name = pct.product_category_name\nJOIN top_categories tc ON COALESCE(pct.product_category_name_english, 'Unknown') = tc.category_name\nJOIN params ON TRUE\nWHERE o.order_purchase_timestamp >= params.start_ts\nGROUP BY year_month, tc.category_name\nORDER BY tc.category_name, year_month;",
