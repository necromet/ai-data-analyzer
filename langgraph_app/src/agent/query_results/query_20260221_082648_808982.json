{
  "sql_query": "SELECT\n  LEFT(r.review_id, 10) AS review_id,\n  LEFT(r.order_id, 10) AS order_id,\n  LEFT(o.customer_id, 10) AS customer_id,\n  MAX(ABS(r.review_score)) AS review_score,\n  COALESCE(r.review_comment_title, '') AS review_title,\n  COALESCE(r.review_comment_message, '') AS review_comment_message,\n  r.review_creation_date\nFROM order_reviews r\nJOIN orders o ON r.order_id = o.order_id\nJOIN customers c ON o.customer_id = c.customer_id\nGROUP BY\n  LEFT(r.review_id, 10),\n  LEFT(r.order_id, 10),\n  LEFT(o.customer_id, 10),\n  COALESCE(r.review_comment_title, ''),\n  COALESCE(r.review_comment_message, ''),\n  r.review_creation_date\nORDER BY\n  review_score DESC,\n  r.review_creation_date DESC\nLIMIT 3;",
