{
  "sql_query": "SELECT\n  CAST(ABS((o.order_delivered_customer_date::date - o.order_purchase_timestamp::date)) AS INTEGER) AS delivery_time_days,\n  AVG(r.review_score)::NUMERIC AS avg_review_score,\n  COUNT(*)::INTEGER AS review_count\nFROM\n  orders o\nJOIN\n  order_reviews r\n  ON o.order_id = r.order_id\nWHERE\n  o.order_purchase_timestamp IS NOT NULL\n  AND o.order_delivered_customer_date IS NOT NULL\n  AND r.review_score IS NOT NULL\nGROUP BY\n  delivery_time_days\nORDER BY\n  delivery_time_days ASC;",
