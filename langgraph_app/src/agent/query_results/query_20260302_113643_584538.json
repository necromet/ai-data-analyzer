{
  "sql_query": "SELECT\n  EXTRACT(YEAR FROM COALESCE(CAST(o.order_purchase_timestamp AS DATE), CAST(o.order_approved_at AS DATE)))::int AS year,\n  EXTRACT(MONTH FROM COALESCE(CAST(o.order_purchase_timestamp AS DATE), CAST(o.order_approved_at AS DATE)))::int AS month,\n  TO_CHAR(COALESCE(CAST(o.order_purchase_timestamp AS DATE), CAST(o.order_approved_at AS DATE)), 'YYYY-MM') AS year_month,\n  ABS(SUM(op.payment_value)) AS total_sales\nFROM orders o\nJOIN order_payments op\n  ON o.order_id = op.order_id\nWHERE COALESCE(CAST(o.order_purchase_timestamp AS DATE), CAST(o.order_approved_at AS DATE)) IS NOT NULL\nGROUP BY 1,2,3\nORDER BY year_month ASC;",
