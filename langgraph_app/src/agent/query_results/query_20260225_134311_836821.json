{
  "sql_query": "SELECT\n  COALESCE(pct.product_category_name_english, 'Unknown') AS product_category_name,\n  ROUND(AVG(DISTINCT r.review_score)::numeric, 2) AS average_review_score,\n  COUNT(DISTINCT r.review_id) AS review_count\nFROM order_reviews r\nJOIN orders o ON r.order_id = o.order_id\nJOIN order_items oi ON o.order_id = oi.order_id\nJOIN products p ON oi.product_id = p.product_id\nLEFT JOIN product_category_translation pct ON p.product_category_name = pct.product_category_name\nWHERE r.review_score IS NOT NULL\nGROUP BY COALESCE(pct.product_category_name_english, 'Unknown')\nORDER BY average_review_score DESC;",
