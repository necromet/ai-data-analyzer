{
  "sql_query": "SELECT\n  c.customer_unique_id,\n  c.customer_city,\n  c.customer_state,\n  COUNT(DISTINCT o.order_id) AS total_orders\nFROM orders AS o\nJOIN customers AS c ON o.customer_id = c.customer_id\nGROUP BY c.customer_unique_id, c.customer_city, c.customer_state\nORDER BY total_orders DESC\nLIMIT 100;",
