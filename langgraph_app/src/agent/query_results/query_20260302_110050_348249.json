{
  "sql_query": "SELECT\n  h.hour_of_day,\n  COALESCE(a.total_revenue, 0) AS total_revenue,\n  COALESCE(a.order_count, 0) AS order_count\nFROM\n  (SELECT generate_series(0,23) AS hour_of_day) AS h\nLEFT JOIN\n  (\n    SELECT\n      EXTRACT(HOUR FROM o.order_purchase_timestamp)::INT AS hour_of_day,\n      ABS(SUM(op.payment_value)) AS total_revenue,\n      COUNT(DISTINCT o.order_id) AS order_count\n    FROM\n      orders o\n    JOIN\n      order_payments op\n      ON o.order_id = op.order_id\n    WHERE\n      CAST(o.order_purchase_timestamp AS DATE) = CAST('2017-11-24' AS DATE)\n    GROUP BY\n      EXTRACT(HOUR FROM o.order_purchase_timestamp)::INT\n  ) AS a\n  USING (hour_of_day)\nORDER BY\n  h.hour_of_day;",
