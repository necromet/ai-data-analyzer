{
  "sql_query": "WITH latest AS (\n  SELECT MAX(o.order_purchase_timestamp) AS max_purchase_ts\n  FROM orders o\n), months AS (\n  SELECT generate_series(\n    date_trunc('month', (SELECT max_purchase_ts::date FROM latest) - INTERVAL '23 months'),\n    date_trunc('month', (SELECT max_purchase_ts::date FROM latest)),\n    INTERVAL '1 month'\n  ) AS month_start\n), category_totals AS (\n  SELECT\n    COALESCE(pct.product_category_name_english, COALESCE(p.product_category_name, 'UNKNOWN')) AS category_name_english,\n    ABS(SUM(oi.price * 1)) AS total_sales_24m\n  FROM orders o\n  JOIN order_items oi ON o.order_id = oi.order_id\n  JOIN products p ON oi.product_id = p.product_id\n  LEFT JOIN product_category_translation pct ON p.product_category_name = pct.product_category_name\n  CROSS JOIN latest l\n  WHERE o.order_purchase_timestamp >= date_trunc('month', (l.max_purchase_ts::date) - INTERVAL '23 months')\n    AND o.order_purchase_timestamp <= l.max_purchase_ts\n  GROUP BY 1\n), top10 AS (\n  SELECT category_name_english\n  FROM category_totals\n  ORDER BY total_sales_24m DESC\n  LIMIT 10\n)\nSELECT\n  t.category_name_english,\n  to_char(m.month_start, 'YYYY-MM') AS year_month,\n  COALESCE(ABS(SUM(oi.price * 1)), 0) AS total_sales\nFROM months m\nCROSS JOIN top10 t\nLEFT JOIN orders o\n  ON date_trunc('month', o.order_purchase_timestamp) = m.month_start\nLEFT JOIN order_items oi\n  ON oi.order_id = o.order_id\nLEFT JOIN products p\n  ON oi.product_id = p.product_id\nLEFT JOIN product_category_translation pct\n  ON p.product_category_name = pct.product_category_name\n    AND COALESCE(pct.product_category_name_english, COALESCE(p.product_category_name, 'UNKNOWN')) = t.category_name_english\nWHERE (o.order_id IS NULL OR (o.order_purchase_timestamp >= m.month_start AND o.order_purchase_timestamp < m.month_start + INTERVAL '1 month'))\nGROUP BY 1, 2\nORDER BY 1, 2;",
