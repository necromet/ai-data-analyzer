{
  "sql_query": "SELECT\n  COALESCE(geo.geolocation_state, c.customer_state) AS state,\n  ABS(SUM(p.payment_value)) AS total_revenue\nFROM orders o\nJOIN customers c\n  ON o.customer_id = c.customer_id\nJOIN order_payments p\n  ON o.order_id = p.order_id\nLEFT JOIN geolocation geo\n  ON CAST(c.customer_zip_code_prefix AS TEXT) = CAST(geo.geolocation_zip_code_prefix AS TEXT)\nGROUP BY COALESCE(geo.geolocation_state, c.customer_state)\nORDER BY total_revenue DESC;",
