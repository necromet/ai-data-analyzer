{
  "sql_query": "WITH completed_orders AS (\n  SELECT\n    o.order_id\n  FROM orders AS o\n  WHERE o.order_status = 'delivered'\n),\norder_totals AS (\n  SELECT\n    op.order_id,\n    op.payment_installments,\n    ABS(SUM(op.payment_value)) AS order_total\n  FROM order_payments AS op\n  INNER JOIN completed_orders AS co\n    ON co.order_id = op.order_id\n  GROUP BY\n    op.order_id,\n    op.payment_installments\n)\nSELECT\n  ot.payment_installments AS payment_installments,\n  AVG(ot.order_total) AS avg_order_value,\n  COUNT(DISTINCT LEFT(ot.order_id, 10)) AS order_count\nFROM order_totals AS ot\nGROUP BY\n  ot.payment_installments\nORDER BY\n  ot.payment_installments ASC;",
