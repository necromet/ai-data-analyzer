{
  "sql_query": "WITH per_ord_pay AS (\n  SELECT\n    op.order_id,\n    op.payment_type,\n    SUM(op.payment_value) AS order_payment_value,\n    MAX(op.payment_installments) AS order_payment_installments\n  FROM order_payments op\n  JOIN orders o ON op.order_id = o.order_id\n  GROUP BY op.order_id, op.payment_type\n),\nagg AS (\n  SELECT\n    payment_type,\n    COUNT(DISTINCT order_id) AS orders_count,\n    SUM(order_payment_value) AS total_sales,\n    AVG(order_payment_value) AS avg_payment_value_per_order,\n    AVG(order_payment_installments) AS avg_payment_installments\n  FROM per_ord_pay\n  GROUP BY payment_type\n),\ntotals AS (\n  SELECT\n    COUNT(DISTINCT op.order_id) AS overall_orders,\n    SUM(op.payment_value) AS overall_sales\n  FROM order_payments op\n  JOIN orders o ON op.order_id = o.order_id\n)\nSELECT\n  a.payment_type,\n  a.orders_count,\n  a.total_sales,\n  a.avg_payment_value_per_order,\n  a.avg_payment_installments,\n  100.0 * a.total_sales / NULLIF(t.overall_sales, 0) AS percent_share_total_sales,\n  t.overall_orders,\n  t.overall_sales\nFROM agg a\nCROSS JOIN totals t\nORDER BY a.total_sales DESC;",
