{
  "sql_query": "WITH order_totals AS (\n  SELECT\n    o.order_id,\n    date_trunc('month', CAST(o.order_purchase_timestamp AS DATE)) AS month,\n    ABS(SUM(op.payment_value)) AS order_total,\n    c.customer_unique_id\n  FROM orders o\n  JOIN order_payments op ON o.order_id = op.order_id\n  JOIN customers c ON o.customer_id = c.customer_id\n  WHERE o.order_purchase_timestamp IS NOT NULL\n  GROUP BY o.order_id, date_trunc('month', CAST(o.order_purchase_timestamp AS DATE)), c.customer_unique_id\n)\nSELECT\n  month,\n  COUNT(DISTINCT order_id) AS order_count,\n  COUNT(DISTINCT customer_unique_id) AS distinct_customers,\n  ABS(SUM(order_total)) AS total_revenue,\n  ABS(AVG(order_total)) AS avg_revenue,\n  CASE\n    WHEN LAG(ABS(AVG(order_total)) ) OVER (ORDER BY month) IS NULL THEN NULL\n    ELSE (ABS(AVG(order_total)) - LAG(ABS(AVG(order_total))) OVER (ORDER BY month)) / NULLIF(LAG(ABS(AVG(order_total))) OVER (ORDER BY month), 0)\n  END AS mom_pct_change\nFROM order_totals\nGROUP BY month\nORDER BY month;",
