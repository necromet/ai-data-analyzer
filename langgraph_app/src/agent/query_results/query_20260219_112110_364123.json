{
  "sql_query": "SELECT\n  EXTRACT(DOW FROM o.order_purchase_timestamp::date) AS weekday_number,\n  TO_CHAR(o.order_purchase_timestamp::date, 'FMDay') AS weekday_name,\n  ABS(SUM(op.payment_value)) AS total_sales\nFROM orders o\nJOIN order_payments op ON o.order_id = op.order_id\nWHERE o.order_purchase_timestamp IS NOT NULL\nGROUP BY 1, 2\nORDER BY 1;",
