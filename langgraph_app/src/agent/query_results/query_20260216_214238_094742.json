{
  "sql_query": "SELECT\n  LEFT(c.customer_unique_id, 10) AS customer_unique_id,\n  ABS(SUM(COALESCE(oi.price::numeric, 0) + COALESCE(oi.freight_value::numeric, 0))) AS total_sales\nFROM orders o\nJOIN customers c\n  ON c.customer_id = o.customer_id\nJOIN order_items oi\n  ON oi.order_id = o.order_id\nGROUP BY\n  LEFT(c.customer_unique_id, 10)\nORDER BY\n  total_sales DESC\nLIMIT 3;",
