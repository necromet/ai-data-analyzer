{
  "sql_query": "SELECT\n  c.customer_unique_id,\n  COUNT(DISTINCT o.order_id) AS total_orders,\n  SUM(COALESCE(pp.total_payment, 0.0)) AS total_revenue,\n  SUM(COALESCE(pp.total_payment, 0.0)) / NULLIF(COUNT(DISTINCT o.order_id), 0) AS avg_order_value,\n  COALESCE(AVG(rr.avg_review_score), 0.0) AS avg_review_score,\n  SUM(COALESCE(io.items_count, 0)) AS total_items_purchased,\n  MIN(o.order_approved_at) AS first_order_date,\n  MAX(o.order_approved_at) AS last_order_date\nFROM orders o\nJOIN customers c\n  ON o.customer_id = c.customer_id\nLEFT JOIN (\n  SELECT order_id, SUM(payment_value) AS total_payment\n  FROM order_payments\n  GROUP BY order_id\n) pp\n  ON o.order_id = pp.order_id\nLEFT JOIN (\n  SELECT order_id, COUNT(*) AS items_count\n  FROM order_items\n  GROUP BY order_id\n) io\n  ON o.order_id = io.order_id\nLEFT JOIN (\n  SELECT order_id, AVG(review_score) AS avg_review_score\n  FROM order_reviews\n  GROUP BY order_id\n) rr\n  ON o.order_id = rr.order_id\nGROUP BY c.customer_unique_id\nORDER BY total_orders DESC\nLIMIT 3;",
