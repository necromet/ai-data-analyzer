{
  "sql_query": "WITH cust_orders AS (\n  SELECT\n    c.customer_unique_id AS cust_uid,\n    c.customer_state AS cust_state\n  FROM orders o\n  JOIN customers c\n    ON o.customer_id = c.customer_id\n),\ncust_agg AS (\n  SELECT\n    cust_uid,\n    COUNT(*) AS total_ord_cnt\n  FROM cust_orders\n  GROUP BY cust_uid\n),\ntop3 AS (\n  SELECT cust_uid\n  FROM cust_agg\n  ORDER BY total_ord_cnt DESC\n  LIMIT 3\n),\nstate_agg AS (\n  SELECT\n    co.cust_uid,\n    co.cust_state,\n    COUNT(*) AS state_ord_cnt\n  FROM cust_orders co\n  JOIN top3 t\n    ON co.cust_uid = t.cust_uid\n  GROUP BY co.cust_uid, co.cust_state\n)\nSELECT\n  s.cust_uid,\n  s.cust_state,\n  s.state_ord_cnt,\n  c.total_ord_cnt\nFROM state_agg s\nJOIN cust_agg c\n  ON s.cust_uid = c.cust_uid\nORDER BY c.total_ord_cnt DESC, s.cust_uid, s.cust_state;",
