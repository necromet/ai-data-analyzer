{
  "sql_query": "SELECT\n  TO_CHAR(CAST(o.order_purchase_timestamp AS DATE), 'YYYY-MM-DD') AS order_date,\n  ABS(SUM(COALESCE(op.payment_value, 0))) AS total_sales\nFROM\n  orders o\nJOIN\n  order_payments op\n  ON o.order_id = op.order_id\nGROUP BY\n  CAST(o.order_purchase_timestamp AS DATE)\nORDER BY\n  total_sales DESC\nLIMIT 25;",
