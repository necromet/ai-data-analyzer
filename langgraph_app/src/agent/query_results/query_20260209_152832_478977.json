{
  "sql_query": "WITH pay_per_ord AS (\n  SELECT\n    order_id,\n    SUM(payment_value) AS ord_pay\n  FROM order_payments\n  GROUP BY order_id\n)\nSELECT\n  c.customer_unique_id AS cust_uid,\n  c.customer_city AS customer_city,\n  c.customer_state AS customer_state,\n  COUNT(DISTINCT o.order_id) AS total_orders,\n  SUM(p.ord_pay) AS total_sales,\n  CASE WHEN COUNT(DISTINCT o.order_id) > 0 THEN SUM(p.ord_pay) / COUNT(DISTINCT o.order_id) ELSE 0 END AS average_order_value,\n  MAX(o.order_purchase_timestamp) AS last_order_date\nFROM orders o\nJOIN customers c\n  ON o.customer_id = c.customer_id\nJOIN pay_per_ord p\n  ON o.order_id = p.order_id\nGROUP BY\n  c.customer_unique_id,\n  c.customer_city,\n  c.customer_state\nORDER BY\n  total_orders DESC,\n  total_sales DESC\nLIMIT 3;",
