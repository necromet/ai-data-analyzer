{
  "sql_query": "WITH top_cust AS (\n  SELECT\n    c.customer_unique_id AS cust_uid,\n    COUNT(o.order_id) AS tot_orders\n  FROM customers c\n  JOIN orders o ON c.customer_id = o.customer_id\n  GROUP BY c.customer_unique_id\n  ORDER BY tot_orders DESC\n  LIMIT 3\n),\nmonths_range AS (\n  SELECT\n    tc.cust_uid,\n    DATE_TRUNC('month', MIN(o.order_purchase_timestamp::timestamp))::date AS min_m,\n    DATE_TRUNC('month', MAX(o.order_purchase_timestamp::timestamp))::date AS max_m\n  FROM top_cust tc\n  JOIN customers c ON c.customer_unique_id = tc.cust_uid\n  JOIN orders o ON c.customer_id = o.customer_id\n  GROUP BY tc.cust_uid\n),\nmonths_expanded AS (\n  SELECT\n    mr.cust_uid,\n    gen.month::date AS month\n  FROM months_range mr\n  CROSS JOIN generate_series(mr.min_m::timestamp, mr.max_m::timestamp, INTERVAL '1 month') AS gen(month)\n),\nmonthly_metrics AS (\n  SELECT\n    c.customer_unique_id AS cust_uid,\n    DATE_TRUNC('month', o.order_purchase_timestamp::timestamp)::date AS month,\n    COUNT(DISTINCT o.order_id) AS monthly_orders,\n    SUM(op.payment_value) AS monthly_sales\n  FROM customers c\n  JOIN orders o ON c.customer_id = o.customer_id\n  JOIN order_payments op ON o.order_id = op.order_id\n  JOIN top_cust tc ON c.customer_unique_id = tc.cust_uid\n  GROUP BY 1,2\n)\nSELECT\n  me.cust_uid,\n  me.month,\n  COALESCE(mm.monthly_orders, 0) AS monthly_orders,\n  COALESCE(mm.monthly_sales, 0.0) AS monthly_sales\nFROM months_expanded me\nLEFT JOIN monthly_metrics mm\n  ON mm.cust_uid = me.cust_uid\n  AND mm.month = me.month\nORDER BY me.cust_uid, me.month;",
