{
  "sql_query": "SELECT\n  cust_uid,\n  order_cnt\nFROM (\n  SELECT\n    customers.customer_unique_id AS cust_uid,\n    COUNT(orders.order_id) AS order_cnt\n  FROM orders\n  JOIN customers\n    ON orders.customer_id = customers.customer_id\n  GROUP BY customers.customer_unique_id\n) t\nORDER BY order_cnt DESC\nLIMIT 3;",
