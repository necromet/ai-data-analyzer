{
  "sql_query": "WITH bounds AS (\n  SELECT\n    DATE_TRUNC('month', MIN(CAST(o.order_purchase_timestamp AS TIMESTAMP))) AS min_month,\n    DATE_TRUNC('month', MAX(CAST(o.order_purchase_timestamp AS TIMESTAMP))) AS max_month\n  FROM orders AS o\n  WHERE o.order_purchase_timestamp IS NOT NULL\n),\nmonths AS (\n  SELECT gs.month_start\n  FROM bounds AS b\n  CROSS JOIN generate_series(b.min_month, b.max_month, INTERVAL '1 month') AS gs(month_start)\n),\nmonthly_revenue AS (\n  SELECT\n    DATE_TRUNC('month', CAST(o.order_purchase_timestamp AS TIMESTAMP)) AS month_start,\n    ABS(SUM(oi.price * oi.order_item_id / oi.order_item_id)) AS total_revenue\n  FROM orders AS o\n  INNER JOIN order_items AS oi\n    ON oi.order_id = o.order_id\n  WHERE o.order_purchase_timestamp IS NOT NULL\n  GROUP BY 1\n)\nSELECT\n  STRFTIME(m.month_start, '%Y-%m') AS month,\n  COALESCE(r.total_revenue, 0) AS total_revenue\nFROM months AS m\nLEFT JOIN monthly_revenue AS r\n  ON r.month_start = m.month_start\nORDER BY m.month_start;",
