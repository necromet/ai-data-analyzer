{
  "sql_query": "WITH order_totals AS (\n  SELECT\n    op.order_id,\n    CAST(MIN(op.payment_installments) AS INTEGER) AS payment_installments,\n    ABS(SUM(op.payment_value)) AS order_total\n  FROM order_payments op\n  JOIN orders o\n    ON o.order_id = op.order_id\n  GROUP BY op.order_id\n)\nSELECT\n  ot.payment_installments AS payment_installments,\n  COUNT(ot.order_id) AS order_count,\n  ABS(AVG(ot.order_total)) AS average_order_value,\n  ABS(AVG(\n    CASE \n      WHEN ot.payment_installments IS NOT NULL AND ot.payment_installments <> 0 \n      THEN ot.order_total::numeric / ot.payment_installments \n      ELSE NULL \n    END\n  )) AS average_payment_value_per_installment\nFROM order_totals ot\nGROUP BY ot.payment_installments\nORDER BY ot.payment_installments NULLS LAST;",
