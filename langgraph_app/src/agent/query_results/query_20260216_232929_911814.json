{
  "sql_query": "SELECT\n  ABS((o.order_delivered_customer_date::date - o.order_estimated_delivery_date::date)) AS shipping_delay_days,\n  AVG(r.review_score::numeric) AS review_score\nFROM orders o\nJOIN order_reviews r ON o.order_id = r.order_id\nWHERE o.order_delivered_customer_date IS NOT NULL\n  AND o.order_estimated_delivery_date IS NOT NULL\n  AND r.review_score IS NOT NULL\nGROUP BY ABS((o.order_delivered_customer_date::date - o.order_estimated_delivery_date::date))\nORDER BY shipping_delay_days;",
