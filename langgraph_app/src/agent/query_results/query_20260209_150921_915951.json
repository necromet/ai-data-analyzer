{
  "sql_query": "WITH payments_shr AS (\n  SELECT\n    order_id,\n    payment_type,\n    payment_value,\n    payment_value / NULLIF(SUM(payment_value) OVER (PARTITION BY order_id), 0) AS payment_share\n  FROM order_payments\n),\ncategory_sales AS (\n  SELECT\n    COALESCE(pct.product_category_name_english, pr.product_category_name) AS category,\n    ps.payment_type,\n    SUM(oi.price * ps.payment_share) AS total_sales\n  FROM order_items oi\n  JOIN products pr USING (product_id)\n  JOIN payments_shr ps USING (order_id)\n  LEFT JOIN product_category_translation pct\n    ON pr.product_category_name = pct.product_category_name\n  GROUP BY category, ps.payment_type\n),\ntop_categories AS (\n  SELECT category\n  FROM (\n    SELECT category, SUM(total_sales) AS cat_total\n    FROM category_sales\n    GROUP BY category\n    ORDER BY cat_total DESC\n    LIMIT 8\n  )\n)\nSELECT\n  cs.category,\n  cs.payment_type,\n  cs.total_sales\nFROM category_sales cs\nJOIN top_categories tc USING (category)\nORDER BY cs.total_sales DESC, cs.category, cs.payment_type;",
