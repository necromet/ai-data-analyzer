{
  "sql_query": "WITH\nzip_centroids AS (\n  SELECT\n    geolocation_zip_code_prefix,\n    AVG(geolocation_lat) AS lat,\n    AVG(geolocation_lng) AS lng\n  FROM geolocation\n  GROUP BY geolocation_zip_code_prefix\n),\ncustomers_loc AS (\n  SELECT\n    c.customer_id,\n    c.customer_unique_id,\n    c.customer_state,\n    z.lat AS customer_lat,\n    z.lng AS customer_lng\n  FROM customers c\n  LEFT JOIN zip_centroids z\n    ON z.geolocation_zip_code_prefix = c.customer_zip_code_prefix\n),\nsellers_loc AS (\n  SELECT\n    s.seller_id,\n    s.seller_state,\n    z.lat AS seller_lat,\n    z.lng AS seller_lng\n  FROM sellers s\n  LEFT JOIN zip_centroids z\n    ON z.geolocation_zip_code_prefix = s.seller_zip_code_prefix\n),\nseller_price_per_order AS (\n  SELECT\n    oi.order_id,\n    oi.seller_id,\n    SUM(oi.price) AS seller_total_price\n  FROM order_items oi\n  GROUP BY oi.order_id, oi.seller_id\n),\nseller_price_with_loc AS (\n  SELECT\n    sp.order_id,\n    sp.seller_id,\n    sp.seller_total_price,\n    sl.seller_lat,\n    sl.seller_lng,\n    sl.seller_state\n  FROM seller_price_per_order sp\n  LEFT JOIN sellers_loc sl\n    ON sp.seller_id = sl.seller_id\n),\norder_seller_centroid AS (\n  SELECT\n    order_id,\n    CASE WHEN SUM(seller_total_price) > 0 THEN SUM(seller_total_price * seller_lat) / SUM(seller_total_price) ELSE NULL END AS seller_lat,\n    CASE WHEN SUM(seller_total_price) > 0 THEN SUM(seller_total_price * seller_lng) / SUM(seller_total_price) ELSE NULL END AS seller_lng\n  FROM seller_price_with_loc\n  GROUP BY order_id\n),\norder_seller_state AS (\n  SELECT order_id, seller_state\n  FROM (\n    SELECT\n      order_id,\n      seller_state,\n      SUM(seller_total_price) AS sum_price,\n      ROW_NUMBER() OVER (PARTITION BY order_id ORDER BY SUM(seller_total_price) DESC) AS rn\n    FROM seller_price_with_loc\n    GROUP BY order_id, seller_state\n  ) t\n  WHERE rn = 1\n),\norders_enriched AS (\n  SELECT\n    o.order_id,\n    o.order_purchase_timestamp,\n    c.customer_unique_id,\n    c.customer_state,\n    c.customer_lat,\n    c.customer_lng,\n    osc.seller_lat,\n    osc.seller_lng,\n    oss.seller_state AS seller_state_dominant\n  FROM orders o\n  LEFT JOIN customers_loc c ON o.customer_id = c.customer_id\n  LEFT JOIN order_seller_centroid osc ON o.order_id = osc.order_id\n  LEFT JOIN order_seller_state oss ON o.order_id = oss.order_id\n),\norders_with_distance AS (\n  SELECT\n    order_id,\n    order_purchase_timestamp,\n    customer_unique_id,\n    customer_state,\n    customer_lat,\n    customer_lng,\n    seller_lat,\n    seller_lng,\n    seller_state_dominant,\n    CASE\n      WHEN customer_lat IS NOT NULL AND seller_lat IS NOT NULL THEN\n        6371.0 * ACOS(\n          LEAST(\n            1.0,\n            GREATEST(\n              -1.0,\n              SIN(RADIANS(customer_lat)) * SIN(RADIANS(seller_lat))\n              + COS(RADIANS(customer_lat)) * COS(RADIANS(seller_lat)) * COS(RADIANS(seller_lng - customer_lng))\n            )\n          )\n        )\n      ELSE NULL\n    END AS distance_km,\n    CASE WHEN customer_lat IS NULL OR seller_lat IS NULL THEN 1 ELSE 0 END AS missing_coords_flag\n  FROM orders_enriched\n)\nSELECT\n  'overall' AS grouping,\n  COUNT(*) AS orders_count,\n  COUNT(DISTINCT customer_unique_id) AS unique_customers,\n  (SELECT COUNT(DISTINCT seller_id) FROM order_items WHERE order_id IN (SELECT order_id FROM orders_with_distance)) AS unique_sellers,\n  AVG(distance_km) AS mean_distance_km,\n  percentile_cont(0.5) WITHIN GROUP (ORDER BY distance_km) AS median_distance_km,\n  percentile_cont(0.25) WITHIN GROUP (ORDER BY distance_km) AS p25_distance_km,\n  percentile_cont(0.75) WITHIN GROUP (ORDER BY distance_km) AS p75_distance_km,\n  MIN(distance_km) AS min_distance_km,\n  MAX(distance_km) AS max_distance_km,\n  STDDEV_SAMP(distance_km) AS stddev_distance_km,\n  COUNT(distance_km) AS sample_size,\n  100.0 * SUM(missing_coords_flag) / NULLIF(COUNT(*),0) AS percent_missing_coordinates\nFROM orders_with_distance\nUNION ALL\nSELECT\n  'by_customer_state:' || customer_state AS grouping,\n  COUNT(*) AS orders_count,\n  COUNT(DISTINCT customer_unique_id) AS unique_customers,\n  COUNT(DISTINCT osm.seller_id) AS unique_sellers,\n  AVG(o.distance_km) AS mean_distance_km,\n  percentile_cont(0.5) WITHIN GROUP (ORDER BY o.distance_km) AS median_distance_km,\n  percentile_cont(0.25) WITHIN GROUP (ORDER BY o.distance_km) AS p25_distance_km,\n  percentile_cont(0.75) WITHIN GROUP (ORDER BY o.distance_km) AS p75_distance_km,\n  MIN(o.distance_km) AS min_distance_km,\n  MAX(o.distance_km) AS max_distance_km,\n  STDDEV_SAMP(o.distance_km) AS stddev_distance_km,\n  COUNT(o.distance_km) AS sample_size,\n  100.0 * SUM(o.missing_coords_flag) / NULLIF(COUNT(*),0) AS percent_missing_coordinates\nFROM orders_with_distance o\nLEFT JOIN order_items osm ON osm.order_id = o.order_id\nWHERE o.customer_state IS NOT NULL\nGROUP BY o.customer_state\nUNION ALL\nSELECT\n  'by_seller_state:' || seller_state_dominant AS grouping,\n  COUNT(*) AS orders_count,\n  COUNT(DISTINCT customer_unique_id) AS unique_customers,\n  COUNT(DISTINCT osm.seller_id) AS unique_sellers,\n  AVG(o.distance_km) AS mean_distance_km,\n  percentile_cont(0.5) WITHIN GROUP (ORDER BY o.distance_km) AS median_distance_km,\n  percentile_cont(0.25) WITHIN GROUP (ORDER BY o.distance_km) AS p25_distance_km,\n  percentile_cont(0.75) WITHIN GROUP (ORDER BY o.distance_km) AS p75_distance_km,\n  MIN(o.distance_km) AS min_distance_km,\n  MAX(o.distance_km) AS max_distance_km,\n  STDDEV_SAMP(o.distance_km) AS stddev_distance_km,\n  COUNT(o.distance_km) AS sample_size,\n  100.0 * SUM(o.missing_coords_flag) / NULLIF(COUNT(*),0) AS percent_missing_coordinates\nFROM orders_with_distance o\nLEFT JOIN order_items osm ON osm.order_id = o.order_id\nWHERE o.seller_state_dominant IS NOT NULL\nGROUP BY o.seller_state_dominant;",
