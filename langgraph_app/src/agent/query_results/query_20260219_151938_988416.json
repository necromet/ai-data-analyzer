{
  "sql_query": "SELECT\n  COALESCE(pct.product_category_name_english, 'Unknown') AS product_category_name_english,\n  ABS(SUM(oi.price + oi.freight_value)) AS total_revenue,\n  COUNT(DISTINCT oi.order_id) AS sales_transactions,\n  ABS(\n    SUM(oi.price + oi.freight_value) / NULLIF(COUNT(DISTINCT oi.order_id), 0)\n  ) AS avg_sale_value,\n  COUNT(DISTINCT c.customer_unique_id) AS unique_customers\nFROM order_items AS oi\nJOIN products AS p\n  ON oi.product_id = p.product_id\nLEFT JOIN product_category_translation AS pct\n  ON p.product_category_name = pct.product_category_name\nJOIN orders AS o\n  ON oi.order_id = o.order_id\nJOIN customers AS c\n  ON o.customer_id = c.customer_id\nWHERE o.order_status = 'delivered'\nGROUP BY COALESCE(pct.product_category_name_english, 'Unknown')\nORDER BY total_revenue DESC;",
