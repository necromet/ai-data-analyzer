  "sql_query": "SELECT\n  TO_CHAR(CAST(o.order_purchase_timestamp AS DATE), 'YYYY-MM') AS year_month,\n  COUNT(DISTINCT LEFT(o.customer_id, 10)) AS unique_customers_count\nFROM\n  orders o\nWHERE\n  o.order_purchase_timestamp IS NOT NULL\nGROUP BY\n  TO_CHAR(CAST(o.order_purchase_timestamp AS DATE), 'YYYY-MM')\nORDER BY\n  year_month;",
