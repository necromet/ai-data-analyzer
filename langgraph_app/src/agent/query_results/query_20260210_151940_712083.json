{
  "sql_query": "WITH payments_total AS (\n  SELECT\n    order_id AS ord_id,\n    SUM(payment_value) AS order_total\n  FROM order_payments\n  GROUP BY order_id\n),\npayments_primary AS (\n  SELECT\n    order_id AS ord_id,\n    payment_type,\n    payment_installments\n  FROM order_payments\n  WHERE payment_sequential = 1\n),\nitems_per_order AS (\n  SELECT\n    order_id AS ord_id,\n    COUNT(order_item_id) AS items_cnt\n  FROM order_items\n  GROUP BY order_id\n),\norder_customers AS (\n  SELECT\n    o.order_id AS ord_id,\n    c.customer_unique_id AS cust_uid\n  FROM orders o\n  JOIN customers c\n    ON o.customer_id = c.customer_id\n),\ncust_order_counts AS (\n  SELECT\n    cust_uid,\n    COUNT(*) AS orders_per_cust\n  FROM order_customers\n  GROUP BY cust_uid\n),\norder_level AS (\n  SELECT\n    pt.ord_id,\n    oc.cust_uid,\n    pt.order_total,\n    COALESCE(pp.payment_type, 'unknown') AS payment_type,\n    COALESCE(pp.payment_installments, 1) AS payment_installments,\n    COALESCE(ip.items_cnt, 0) AS items_cnt,\n    CASE WHEN coc.orders_per_cust > 1 THEN 1 ELSE 0 END AS is_repeat\n  FROM payments_total pt\n  JOIN order_customers oc\n    ON pt.ord_id = oc.ord_id\n  LEFT JOIN payments_primary pp\n    ON pt.ord_id = pp.ord_id\n  LEFT JOIN items_per_order ip\n    ON pt.ord_id = ip.ord_id\n  LEFT JOIN cust_order_counts coc\n    ON oc.cust_uid = coc.cust_uid\n)\nSELECT\n  payment_type,\n  CASE WHEN payment_type = 'boleto' THEN 'boleto' ELSE 'others' END AS pay_group,\n  AVG(order_total) AS avg_ticket,\n  MEDIAN(order_total) AS median_order_value,\n  SUM(order_total) AS total_sales,\n  COUNT(*) AS order_count,\n  AVG(payment_installments) AS avg_payment_installments,\n  AVG(items_cnt) AS avg_items_per_order,\n  100.0 * SUM(is_repeat) / COUNT(*) AS pct_repeat_orders\nFROM order_level\nGROUP BY payment_type\nORDER BY avg_ticket DESC;",
