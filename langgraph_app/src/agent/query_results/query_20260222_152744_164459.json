{
  "sql_query": "SELECT\n  to_char(CAST(o.order_purchase_timestamp AS DATE), 'FMDay') AS order_weekday,\n  EXTRACT(hour FROM o.order_purchase_timestamp)::int AS order_hour,\n  ROUND(\n    AVG(\n      ABS(\n        (CAST(o.order_delivered_customer_date AS DATE) - CAST(o.order_purchase_timestamp AS DATE))::int\n      )\n    )::numeric\n  , 2) AS avg_delivery_delay_days,\n  COUNT(o.order_id) AS order_count\nFROM orders o\nWHERE o.order_status = 'delivered'\n  AND o.order_purchase_timestamp IS NOT NULL\n  AND o.order_delivered_customer_date IS NOT NULL\nGROUP BY\n  ((EXTRACT(dow FROM CAST(o.order_purchase_timestamp AS DATE))::int + 6) % 7) + 1,\n  to_char(CAST(o.order_purchase_timestamp AS DATE), 'FMDay'),\n  EXTRACT(hour FROM o.order_purchase_timestamp)::int\nORDER BY\n  ((EXTRACT(dow FROM CAST(o.order_purchase_timestamp AS DATE))::int + 6) % 7) + 1,\n  order_hour;",
