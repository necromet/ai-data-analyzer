{
  "sql_query": "SELECT\n  COALESCE(pct.product_category_name_english, 'Unknown') AS product_category,\n  AVG(DATE_DIFF('day', CAST(o.order_estimated_delivery_date AS DATE), CAST(o.order_delivered_customer_date AS DATE))) AS avg_shipping_delay_days,\n  AVG(orv.review_score) AS avg_review_score\nFROM order_items oi\nJOIN orders o\n  ON o.order_id = oi.order_id\nJOIN products p\n  ON p.product_id = oi.product_id\nLEFT JOIN product_category_translation pct\n  ON pct.product_category_name = p.product_category_name\nJOIN order_reviews orv\n  ON orv.order_id = o.order_id\nWHERE o.order_delivered_customer_date IS NOT NULL\n  AND o.order_estimated_delivery_date IS NOT NULL\nGROUP BY\n  COALESCE(pct.product_category_name_english, 'Unknown')\nORDER BY\n  product_category;",
