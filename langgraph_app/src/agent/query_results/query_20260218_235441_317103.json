{
  "sql_query": "SELECT\n  date_trunc('month', o.order_purchase_timestamp)::date AS month,\n  COUNT(DISTINCT o.order_id) AS orders_count,\n  COUNT(DISTINCT c.customer_unique_id) AS unique_customers_count,\n  ABS(\n    COUNT(DISTINCT o.order_id)\n    - LAG(COUNT(DISTINCT o.order_id)) OVER (ORDER BY date_trunc('month', o.order_purchase_timestamp)::date)\n  ) AS orders_mom_absolute,\n  CASE\n    WHEN LAG(COUNT(DISTINCT o.order_id)) OVER (ORDER BY date_trunc('month', o.order_purchase_timestamp)::date) IS NULL\n      THEN NULL\n    WHEN LAG(COUNT(DISTINCT o.order_id)) OVER (ORDER BY date_trunc('month', o.order_purchase_timestamp)::date) = 0\n      THEN NULL\n    ELSE ABS(\n      (COUNT(DISTINCT o.order_id)::numeric\n       - LAG(COUNT(DISTINCT o.order_id)) OVER (ORDER BY date_trunc('month', o.order_purchase_timestamp)::date)::numeric)\n      / LAG(COUNT(DISTINCT o.order_id)) OVER (ORDER BY date_trunc('month', o.order_purchase_timestamp)::date)::numeric\n    )\n  END AS orders_mom_pct\nFROM\n  orders o\nJOIN\n  customers c\nON\n  o.customer_id = c.customer_id\nWHERE\n  o.order_purchase_timestamp IS NOT NULL\nGROUP BY\n  date_trunc('month', o.order_purchase_timestamp)::date\nORDER BY\n  month;",
