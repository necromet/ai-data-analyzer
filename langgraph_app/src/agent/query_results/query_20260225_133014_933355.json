{
  "sql_query": "WITH order_level AS (\n  SELECT\n    op.order_id,\n    ABS(SUM(op.payment_value)) AS total_payment_value,\n    AVG(orv.review_score) AS avg_review_score\n  FROM order_payments op\n  LEFT JOIN order_reviews orv ON orv.order_id = op.order_id\n  GROUP BY op.order_id\n)\nSELECT\n  COALESCE(pct.product_category_name_english, 'Unknown') AS product_category_name_english,\n  ABS(AVG(oi.price)) AS avg_price,\n  ABS(AVG(oi.freight_value)) AS avg_freight_value,\n  ABS(AVG(ol.total_payment_value)) AS avg_payment_value,\n  AVG(ol.avg_review_score) AS avg_review_score,\n  ABS(SUM(oi.price)) AS total_revenue,\n  ABS(COUNT(oi.*)) AS total_units_sold,\n  COUNT(DISTINCT o.order_id) AS order_count\nFROM order_items oi\nJOIN orders o ON o.order_id = oi.order_id\nJOIN products p ON p.product_id = oi.product_id\nLEFT JOIN product_category_translation pct ON pct.product_category_name = p.product_category_name\nLEFT JOIN order_level ol ON ol.order_id = o.order_id\nGROUP BY COALESCE(pct.product_category_name_english, 'Unknown')\nHAVING COUNT(DISTINCT o.order_id) >= 30;",
