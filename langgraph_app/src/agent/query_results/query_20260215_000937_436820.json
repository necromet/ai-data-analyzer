{
  "sql_query": "WITH order_sales_by_day AS (\n  SELECT\n    CAST(o.order_purchase_timestamp AS DATE) AS order_date,\n    ABS(SUM(oi.price * oi.order_item_id)) AS total_sales\n  FROM orders AS o\n  JOIN order_items AS oi\n    ON oi.order_id = o.order_id\n  WHERE o.order_purchase_timestamp IS NOT NULL\n  GROUP BY\n    CAST(o.order_purchase_timestamp AS DATE)\n)\nSELECT\n  DATE_TRUNC('month', os.order_date) AS month_start,\n  EXTRACT('year' FROM os.order_date) AS year,\n  EXTRACT('month' FROM os.order_date) AS month,\n  EXTRACT('dow' FROM os.order_date) AS weekday_num,\n  STRFTIME(os.order_date, '%A') AS weekday_name,\n  ABS(SUM(os.total_sales)) AS total_sales\nFROM order_sales_by_day AS os\nGROUP BY\n  DATE_TRUNC('month', os.order_date),\n  EXTRACT('year' FROM os.order_date),\n  EXTRACT('month' FROM os.order_date),\n  EXTRACT('dow' FROM os.order_date),\n  STRFTIME(os.order_date, '%A')\nORDER BY\n  month_start,\n  weekday_num;",
