{
  "sql_query": "WITH customer_order_counts AS (\n  SELECT\n    c.customer_unique_id,\n    c.customer_city,\n    c.customer_state,\n    COUNT(o.order_id) AS total_orders\n  FROM customers c\n  JOIN orders o\n    ON o.customer_id = c.customer_id\n  GROUP BY\n    c.customer_unique_id,\n    c.customer_city,\n    c.customer_state\n)\nSELECT\n  customer_unique_id,\n  customer_city,\n  customer_state,\n  total_orders\nFROM (\n  SELECT\n    coc.*,\n    RANK() OVER (ORDER BY total_orders DESC) AS rnk\n  FROM customer_order_counts coc\n) t\nWHERE rnk <= 3\nORDER BY total_orders DESC, customer_unique_id;",
