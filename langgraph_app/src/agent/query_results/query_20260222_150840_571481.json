{
  "sql_query": "SELECT\n  LEFT(r.review_id, 10) AS review_id,\n  LEFT(r.order_id, 10) AS order_id,\n  LEFT(MIN(oi.product_id), 10) AS product_id,\n  LEFT(MAX(o.customer_id), 10) AS customer_id,\n  COALESCE(MAX(r.review_comment_title), '') AS review_title,\n  COALESCE(MAX(r.review_comment_message), '') AS review_comment_message,\n  MAX(r.review_score) AS review_score,\n  MAX(r.review_creation_date) AS review_creation_date\nFROM order_reviews r\nJOIN orders o\n  ON r.order_id = o.order_id\nLEFT JOIN order_items oi\n  ON o.order_id = oi.order_id\nGROUP BY r.review_id\nORDER BY MAX(r.review_score) DESC,\n         MAX(r.review_creation_date) DESC\nLIMIT 3;",
