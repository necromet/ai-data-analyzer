{
  "sql_query": "SELECT\n  LEFT(s.seller_id, 10) AS seller_id,\n  COALESCE(s.seller_city || ' - ' || s.seller_state, LEFT(s.seller_id, 10)) AS seller_name,\n  ABS(SUM(oi.price + oi.freight_value))::numeric(18,2) AS total_revenue,\n  COUNT(DISTINCT oi.order_id) AS total_orders,\n  SUM(1) FILTER (WHERE oi.order_item_id IS NOT NULL) AS total_units_sold,\n  ABS(\n    CASE WHEN COUNT(DISTINCT oi.order_id) = 0 THEN 0\n    ELSE SUM(oi.price + oi.freight_value) / COUNT(DISTINCT oi.order_id)\n    END\n  )::numeric(18,2) AS avg_order_value\nFROM order_items oi\nJOIN sellers s\n  ON oi.seller_id = s.seller_id\nGROUP BY\n  LEFT(s.seller_id, 10),\n  COALESCE(s.seller_city || ' - ' || s.seller_state, LEFT(s.seller_id, 10))\nORDER BY total_revenue DESC\nLIMIT 50;",
