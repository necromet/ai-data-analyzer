{
  "sql_query": "SELECT\n  CAST(o.order_purchase_timestamp AS DATE) AS purchase_date,\n  ABS(SUM(op.payment_value)) AS total_spending\nFROM\n  orders o\nJOIN\n  order_payments op\nON\n  o.order_id = op.order_id\nGROUP BY\n  CAST(o.order_purchase_timestamp AS DATE)\nORDER BY\n  total_spending DESC\nLIMIT 10;",
