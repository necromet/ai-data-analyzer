{
  "sql_query": "WITH payments_by_order AS (\n  SELECT\n    order_id AS ord_id,\n    SUM(payment_value) AS ord_pay\n  FROM order_payments\n  GROUP BY order_id\n)\nSELECT\n  c.customer_unique_id AS cust_unq,\n  COUNT(DISTINCT o.order_id) AS ord_cnt,\n  COALESCE(SUM(p.ord_pay), 0) AS tot_pay,\n  COALESCE(ROUND(AVG(p.ord_pay), 2), 0) AS avg_pay\nFROM orders o\nJOIN customers c ON o.customer_id = c.customer_id\nLEFT JOIN payments_by_order p ON o.order_id = p.ord_id\nWHERE o.order_status = 'delivered'\nGROUP BY c.customer_unique_id\nORDER BY ord_cnt DESC, tot_pay DESC\nLIMIT 3;",
