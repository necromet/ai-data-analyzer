{
  "sql_query": "WITH customer_totals AS (\n  SELECT\n    c.customer_unique_id AS cust_uid,\n    COUNT(o.order_id) AS tot_ord\n  FROM orders o\n  JOIN customers c ON o.customer_id = c.customer_id\n  GROUP BY c.customer_unique_id\n),\ntop_customers AS (\n  SELECT cust_uid\n  FROM customer_totals\n  ORDER BY tot_ord DESC\n  LIMIT 3\n)\nSELECT\n  c.customer_unique_id AS cust_uid,\n  c.customer_state AS cust_state,\n  COUNT(o.order_id) AS ord_cnt,\n  ct.tot_ord AS tot_ord\nFROM orders o\nJOIN customers c ON o.customer_id = c.customer_id\nJOIN customer_totals ct ON ct.cust_uid = c.customer_unique_id\nJOIN top_customers tc ON tc.cust_uid = ct.cust_uid\nGROUP BY c.customer_unique_id, c.customer_state, ct.tot_ord\nORDER BY ct.tot_ord DESC, c.customer_unique_id, c.customer_state;",
