{
  "sql_query": "SELECT\n  CAST(o.order_purchase_timestamp AS DATE) AS purchase_date,\n  ABS(SUM(op.payment_value)) AS total_payment\nFROM orders o\nJOIN order_payments op ON o.order_id = op.order_id\nWHERE CAST(o.order_purchase_timestamp AS DATE) BETWEEN CAST('2017-11-01' AS DATE) AND CAST('2017-11-30' AS DATE)\nGROUP BY CAST(o.order_purchase_timestamp AS DATE)\nORDER BY purchase_date;",
