{
  "sql_query": "WITH total_cte AS (\n  SELECT COUNT(DISTINCT order_id) AS total_orders\n  FROM order_payments\n  WHERE payment_sequential = 1\n),\nby_pay_type AS (\n  SELECT\n    payment_type,\n    COUNT(DISTINCT order_id) AS order_count,\n    ROUND(100.0 * COUNT(DISTINCT order_id) / total_cte.total_orders, 2) AS pct_share\n  FROM order_payments\n  CROSS JOIN total_cte\n  WHERE payment_sequential = 1\n  GROUP BY payment_type, total_cte.total_orders\n)\nSELECT payment_type, order_count, pct_share\nFROM (\n  SELECT payment_type, order_count, pct_share FROM by_pay_type\n  UNION ALL\n  SELECT 'TOTAL' AS payment_type, total_orders AS order_count, 100.00 AS pct_share FROM total_cte\n) t\nORDER BY (payment_type = 'TOTAL') ASC, order_count DESC;",
