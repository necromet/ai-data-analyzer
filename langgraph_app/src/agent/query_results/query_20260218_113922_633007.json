  "sql_query": "SELECT COUNT(*) AS customers_with_more_than_one_purchase\nFROM (\n  SELECT LEFT(c.customer_unique_id, 10) AS customer_uid\n  FROM customers c\n  JOIN orders o ON o.customer_id = c.customer_id\n  GROUP BY LEFT(c.customer_unique_id, 10)\n  HAVING COUNT(DISTINCT o.order_id) > 1\n) t;",
