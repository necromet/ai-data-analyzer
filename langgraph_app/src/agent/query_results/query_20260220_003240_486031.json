{
  "sql_query": "SELECT\n  ABS((o.order_delivered_customer_date::date - o.order_purchase_timestamp::date))::int AS shipping_delay_days,\n  r.review_score::int AS review_score,\n  COUNT(DISTINCT LEFT(o.order_id, 10)) AS orders_count\nFROM\n  orders o\n  JOIN order_reviews r\n    ON o.order_id = r.order_id\nWHERE\n  o.order_purchase_timestamp IS NOT NULL\n  AND o.order_delivered_customer_date IS NOT NULL\n  AND r.review_score IS NOT NULL\nGROUP BY\n  ABS((o.order_delivered_customer_date::date - o.order_purchase_timestamp::date))::int,\n  r.review_score::int\nORDER BY\n  shipping_delay_days,\n  review_score;",
