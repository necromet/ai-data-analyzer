{
  "sql_query": "SELECT\n  LEFT(s.seller_id, 10) AS seller_id,\n  COALESCE(s.seller_city, s.seller_state, LEFT(s.seller_id, 10)) AS seller_name,\n  ABS(SUM(oi.price)) AS total_revenue\nFROM order_items oi\nJOIN sellers s\n  ON oi.seller_id = s.seller_id\nGROUP BY\n  LEFT(s.seller_id, 10),\n  COALESCE(s.seller_city, s.seller_state, LEFT(s.seller_id, 10))\nORDER BY total_revenue DESC\nLIMIT 3;",
