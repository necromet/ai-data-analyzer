 ! SQL Generated for review:
WITH monthly_revenue AS (
  SELECT
    DATE_TRUNC('month', CAST(o.order_purchase_timestamp AS DATE)) AS month,
    ABS(SUM(op.payment_value)) AS total_revenue
  FROM orders o
  JOIN order_payments op ON o.order_id = op.order_id
  WHERE o.order_status = 'delivered'
    AND o.order_purchase_timestamp IS NOT NULL
    AND op.payment_value IS NOT NULL
  GROUP BY DATE_TRUNC('month', CAST(o.order_purchase_timestamp AS DATE))
)
SELECT
  month,
  total_revenue,
  LAG(total_revenue) OVER (ORDER BY month) AS previous_month_revenue,
  CASE
    WHEN LAG(total_revenue) OVER (ORDER BY month) IS NULL THEN NULL
    WHEN LAG(total_revenue) OVER (ORDER BY month) = 0 THEN NULL
    ELSE ABS(total_revenue - LAG(total_revenue) OVER (ORDER BY month)) / NULLIF(LAG(total_revenue) OVER (ORDER BY month), 0)
  END AS month_over_month_growth_rate
FROM monthly_revenue
ORDER BY month;
